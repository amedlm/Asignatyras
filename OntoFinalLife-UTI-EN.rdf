  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#QualityOfLife">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Quality of life</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#PatientValue"/>
    <rdfs:comment xml:lang="en">A patient value concerned with the perceived quality, rather than mere duration, of remaining life.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#var_p">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#norepi_CarlosM">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://onto-finallife-uti.org/ontology#NorepinephrineDose"/>
    <hasBiomarkerValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.3</hasBiomarkerValue>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#var_opt">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#APACHEIIScore">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">APACHE II score (Acute Physiology and Chronic Health Evaluation II)</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#SeverityScore"/>
    <rdfs:comment xml:lang="en">Classic ICU severity score (Knaus et al., 1985), not directly materialised in MIMIC-IV; its acute-physiology component is approximated in MIMIC-IV by the APS-III sub-score.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#Rule16_AuditTrailGeneration">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label xml:lang="en">Rule 16: Audit trail generation</rdfs:label>
    <rdfs:comment>Patient_ICU(?p) ^ hasDecisionProcess(?p,?dp) ^ hasAgent(?dp,?a) ^ hasTimestamp(?dp,?t) ^ hasDecision(?dp,?d) -&gt; generatesAuditTrail(?dp,?trail)</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#CompleteDocumentation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Complete documentation</rdfs:label>
    <rdfs:comment xml:lang="en">A decision process whose clinical, value, consensus, and rationale documentation are all present (output of Rule 15).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#hasTimeWindow">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:comment xml:lang="en">Time window in hours.</rdfs:comment>
  </rdf:Description>
