  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#DNR_DNI">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Combined Do Not Resuscitate / Do Not Intubate</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#CodeStatus"/>
    <rdfs:comment xml:lang="en">A code status combining both Do-Not-Resuscitate and Do-Not-Intubate orders.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#RefractorySufferingSituation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Refractory suffering situation</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#ClinicalState"/>
    <rdfs:comment xml:lang="en">Class of the OntoFinalLife-UTI ontology representing: Refractory suffering situation.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#hasClinicalState">
