  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dc:title>OntoFinalLife-UTI: An Integrated Clinical-Ethical Ontology for End-of-Life Decision Support in Intensive Care Units</dc:title>
    <dc:creator>Amed Leiva Mederos</dc:creator>
    <dc:creator>Jose Antonio Senso Ruiz</dc:creator>
    <dc:creator>Fernando Ortiz Rodriguez</dc:creator>
    <dc:creator>Armando David Caballero Font</dc:creator>
    <dc:creator>Maria Matilde Garcia Lorenzo</dc:creator>
    <dc:creator>Rafael Bello Perez</dc:creator>
    <dc:creator>Lisandra Diaz de la Paz</dc:creator>
    <dc:creator>Daniel Galvez Lio</dc:creator>
    <rdfs:comment>OWL 2 DL ontology (EL++ profile) integrating the objective clinical dimension, the normative ethical dimension, and the personal evaluative dimension for end-of-life treatment-limitation decisions in the ICU. Reuses SNOMED CT, LOINC, ICNP, the TIME Ontology and PROV-O, and adds a severity-score / clinical-analysis module grounded in the MIMIC-IV derived-concepts schema (MIT-LCP), extended with 21 SWRL rules across 6 functional categories.</rdfs:comment>
    <owl:versionInfo>1.1 - English edition, MIMIC-IV grounded clinical module</owl:versionInfo>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#Rule16_SWRL">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label xml:lang="en">Rule 16 (RDF/SWRL): Audit trail generation</rdfs:label>
    <swrl:body rdf:nodeID="Nf0358b30ea1c4bfc82a32568fad83df4"/>
    <swrl:head rdf:nodeID="Ne49ea2f816ee460d9d6ae1e67bc2e94b"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#Option_Against_Values">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Treatment option contrary to patient values</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#EthicalEntity"/>
    <rdfs:comment xml:lang="en">A treatment option that has been found incompatible with a patient's expressed values or advance directive.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#Rule5_SWRL">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label xml:lang="en">Rule 5 (RDF/SWRL): Detection of non-maleficence violation</rdfs:label>
    <swrl:body rdf:nodeID="N8749786b1c11476483385914226c4042"/>
    <swrl:head rdf:nodeID="N9bbf4b6cd0294a24bacc100501752860"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#Rule19_ConflictRecognition">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label xml:lang="en">Rule 19: Recognition of conflicts</rdfs:label>
    <rdfs:comment>Patient_ICU(?p) ^ hasAgent(?p,?a1) ^ hasAgent(?p,?a2) ^ expressesValue(?a1,?v1) ^ expressesValue(?a2,?v2) ^ swrlb:differentFrom(?v1,?v2) -&gt; hasDisagreementWith(?a1,?a2)</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#NorepinephrineEquivalentDose">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Norepinephrine-equivalent dose (NEE)</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#VasoactiveDose"/>
    <rdfs:comment xml:lang="en">Composite vasopressor burden expressed as a single norepinephrine-equivalent value (combines norepinephrine, epinephrine, dopamine, vasopressin, phenylephrine). MIMIC-IV derived table: mimiciv_derived.norepinephrine_equivalent_dose.</rdfs:comment>
    <mimic:norepinephrine_equivalent_dose>mimiciv_derived.norepinephrine_equivalent_dose</mimic:norepinephrine_equivalent_dose>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#AD_CarlosM">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://onto-finallife-uti.org/ontology#AdvanceDirective"/>
    <expressesPreference rdf:resource="http://onto-finallife-uti.org/ontology#Non_Suffering"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N5946c882fec34416a312c093ec5899fd">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
    <swrl:propertyPredicate rdf:resource="http://onto-finallife-uti.org/ontology#hasValueDocumentation"/>
    <swrl:argument1 rdf:resource="http://onto-finallife-uti.org/ontology#var_dp"/>
    <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrl:argument2>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N55e0012f473b4a9cac1e91aab5db4b56">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
    <swrl:classPredicate rdf:resource="http://onto-finallife-uti.org/ontology#Situation_Futility"/>
    <swrl:argument1 rdf:resource="http://onto-finallife-uti.org/ontology#var_cs"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#LegalFramework">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Applicable legal framework</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#LegalEntity"/>
    <rdfs:comment xml:lang="en">The body of statute, case law, or regulation applicable to end-of-life treatment-limitation decisions in a given jurisdiction.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#hasReversalPotential">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://onto-finallife-uti.org/ontology#ClinicalState"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nd87ac513cc704619bfd70d87ef86b72f">
    <rdf:first rdf:nodeID="N75e9a760355049fd840a6ced1c70be6d"/>
    <rdf:rest rdf:nodeID="N7e2d8104817f434ebd654d6608d021b3"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#GlasgowComaScaleScore">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Glasgow Coma Scale (GCS)</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#SeverityScore"/>
    <rdfs:comment xml:lang="en">Eye/verbal/motor consciousness score, also used as a SOFA/APACHE/LODS sub-component. MIMIC-IV derived tables: mimiciv_derived.gcs, mimiciv_derived.first_day_gcs.</rdfs:comment>
    <skos:exactMatch rdf:resource="http://loinc.org/9269-2"/>
    <mimic:gcs>mimiciv_derived.gcs; mimiciv_derived.first_day_gcs</mimic:gcs>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#fio2_CarlosM">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://onto-finallife-uti.org/ontology#FiO2"/>
    <hasBiomarkerValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.8</hasBiomarkerValue>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#PEEP">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Positive end-expiratory pressure (PEEP)</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#RespiratoryParameter"/>
    <rdfs:comment xml:lang="en">The airway pressure maintained at the end of expiration during mechanical ventilation, used to keep alveoli open.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#ClinicalAnalysis">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Clinical analysis</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#ClinicalEntity"/>
    <rdfs:comment xml:lang="en">Groups laboratory measurements, severity scores, and ICU physiological parameters. Individuals in this branch are annotated with the MIMIC-IV derived table that computes them, where applicable.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#lactate_CarlosM">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://onto-finallife-uti.org/ontology#SerumLactate"/>
    <rdfs:comment xml:lang="en">3.8 mmol/L</rdfs:comment>
    <hasBiomarkerValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">3.8</hasBiomarkerValue>
  </rdf:Description>
