  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#Prognosis">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Prognosis</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#ClinicalEntity"/>
    <rdfs:comment xml:lang="en">Represents the projected clinical trajectory of a patient, notably the estimated probability of survival used by Rule 1 to detect futility.</rdfs:comment>
  </rdf:Description>
