  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#InformedConsent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Informed consent</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#LegalEntity"/>
    <rdfs:comment xml:lang="en">The documented process by which a patient or surrogate is informed of, and agrees to or declines, a proposed treatment.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N438c691c6724479d97a08d88a6ac4244">
