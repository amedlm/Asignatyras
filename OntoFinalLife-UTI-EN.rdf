    <swrl:propertyPredicate rdf:resource="http://onto-finallife-uti.org/ontology#hasDecisionProcess"/>
    <swrl:argument1 rdf:resource="http://onto-finallife-uti.org/ontology#var_p"/>
    <swrl:argument2 rdf:resource="http://onto-finallife-uti.org/ontology#var_dp"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#recordsRefractorySuffering">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://onto-finallife-uti.org/ontology#ClinicalState"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#Rule8_UrgencyLevel">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label xml:lang="en">Rule 8: Determination of urgency level</rdfs:label>
    <rdfs:comment>Patient_ICU(?p) ^ hasClinicalState(?p,?cs) ^ hasReversalPotential(?cs,true) ^ hasTimeWindow(?cs,?tw) ^ swrlb:lessThan(?tw,24) -&gt; hasUrgency(?p,'emergency')</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#Intensivist">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Intensivist</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#HealthcareProfessional"/>
    <rdfs:comment xml:lang="en">A physician specialised in critical care medicine, typically the lead clinical decision-maker in the ICU.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#HepaticFailure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Hepatic failure</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#OrganFailure"/>
    <rdfs:comment xml:lang="en">Inadequate liver function, commonly staged in this ontology via the MELD score.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N620b96d0e512483cb4633c24b88ee144">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
