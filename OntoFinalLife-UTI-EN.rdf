    <swrl:head rdf:nodeID="Nbe3c47fb6cc749558fe039ca39dcae1b"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#cs1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://onto-finallife-uti.org/ontology#MultipleOrganFailureSyndrome"/>
    <hasReversalPotential rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</hasReversalPotential>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#PatientValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Patient value</rdfs:label>
    <rdfs:comment xml:lang="en">A value, preference, or goal expressed by the patient (directly or through an advance directive) that treatment options should respect.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nce7a0002d45d469b8e7722fbd0704db2">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
