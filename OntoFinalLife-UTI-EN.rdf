  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#RespiratoryTherapist">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Respiratory therapist</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#HealthcareProfessional"/>
    <rdfs:comment xml:lang="en">An allied health professional specialised in managing ventilatory support and airway care.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#EthicsCommitteeMember">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Ethics committee member</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#Agent"/>
    <rdfs:comment xml:lang="en">Superclass of Bioethicist, Chaplain, and PatientAdvocate when acting on the committee.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N1b7ee48ad5a8458ca800a3372df65c8b">
    <rdf:first rdf:nodeID="N7e051814e64b4e22964f15c002b6ebe6"/>
