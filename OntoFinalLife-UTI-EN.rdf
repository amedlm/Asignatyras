  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#SerumLactate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Serum lactate</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#PerfusionBiomarker"/>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#LaboratoryTest"/>
    <skos:exactMatch rdf:resource="http://loinc.org/2524-7"/>
    <mimic:bg>mimiciv_derived.bg</mimic:bg>
    <rdfs:comment xml:lang="en">Blood concentration of lactate, a marker of anaerobic metabolism and tissue hypoperfusion.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#PatientAdvocate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Patient advocate</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#EthicsCommitteeMember"/>
    <rdfs:comment xml:lang="en">An ethics committee member whose role is to represent the patient's interests and perspective in deliberation.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#Chaplain">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Chaplain / spiritual care provider</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#EthicsCommitteeMember"/>
    <rdfs:comment xml:lang="en">An ethics committee member who attends to the spiritual and religious dimension of end-of-life care.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#Rule20_SWRL">
