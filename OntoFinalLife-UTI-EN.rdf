    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#EthicsCommitteeMember"/>
    <rdfs:comment xml:lang="en">An ethics committee member with formal training in clinical or biomedical ethics.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#AttendingPhysician">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Attending physician</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#Intensivist"/>
    <rdfs:comment xml:lang="en">The intensivist formally responsible for the patient's care during a given period.</rdfs:comment>
  </rdf:Description>
