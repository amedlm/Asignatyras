  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#Rule13_DecisionQualityAssessment">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label xml:lang="en">Rule 13: Decision quality assessment</rdfs:label>
    <rdfs:comment>Patient_ICU(?p) ^ hasDecisionProcess(?p,?dp) ^ hasConsensus(?dp,true) ^ hasEthicalConsistency(?dp,true) ^ hasClinicalAlignment(?dp,true) -&gt; QualityDecision(?dp)</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#Rule21_SWRL">
