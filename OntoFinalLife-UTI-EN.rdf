  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#Rule14_ReevaluationNeedDetection">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label xml:lang="en">Rule 14: Detection of re-evaluation needs</rdfs:label>
    <rdfs:comment>Patient_ICU(?p) ^ hasDecisionProcess(?p,?dp) ^ hasDecision(?dp,?d) ^ hasTemporalValidity(?d,?tv) ^ hasDecisionTime(?d,?dt) ^ hasReevaluationThreshold(?d,168) ^ [elapsed&gt;tv] -&gt; RequiresReevaluation(?d)</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#Rule15_DocumentationCompletenessCheck">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label xml:lang="en">Rule 15: Documentation completeness check</rdfs:label>
    <rdfs:comment>Patient_ICU(?p) ^ hasDecisionProcess(?p,?dp) ^ hasClinicalData(?dp,true) ^ hasValueDocumentation(?dp,true) ^ hasConsensusDocumentation(?dp,true) ^ hasRationaleDocumentation(?dp,true) -&gt; CompleteDocumentation(?dp)</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N593a3713cdcb4e8f98c41f57931b37b2">
    <rdf:first rdf:resource="http://onto-finallife-uti.org/ontology#var_elapsed"/>
