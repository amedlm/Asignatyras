  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#TemporalEntity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Temporal entity</rdfs:label>
    <rdfs:comment xml:lang="en">Aligned with time:TemporalEntity (W3C TIME Ontology).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2006/time#TemporalEntity"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#hasPriority">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N891d6db8daeb49b08a38caca86dabe7b">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
    <swrl:classPredicate rdf:resource="http://onto-finallife-uti.org/ontology#RequiresReevaluation"/>
    <swrl:argument1 rdf:resource="http://onto-finallife-uti.org/ontology#var_d"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#KDIGOStage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">KDIGO AKI stage (Kidney Disease: Improving Global Outcomes)</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#OrganSpecificStagingScale"/>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#RenalFailure"/>
    <rdfs:comment xml:lang="en">Acute kidney injury staging (1-3) based on creatinine and urine output criteria. MIMIC-IV derived tables: mimiciv_derived.kdigo_stages, kdigo_creatinine, kdigo_uo.</rdfs:comment>
    <mimic:kdigo_stages>mimiciv_derived.kdigo_stages</mimic:kdigo_stages>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#DirectiveValidityPeriod">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Advance-directive validity period</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#TemporalEntity"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2006/time#Interval"/>
    <rdfs:comment xml:lang="en">The time interval during which a given advance directive is considered legally and clinically current.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nf817bcd599e64a3eb18fe7b1c2aba961">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
    <swrl:propertyPredicate rdf:resource="http://onto-finallife-uti.org/ontology#hasSeverity"/>
    <swrl:argument1 rdf:resource="http://onto-finallife-uti.org/ontology#var_harm"/>
    <swrl:argument2>high</swrl:argument2>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N34ee460f9030465fac3e46dc77334e20">
    <rdf:first rdf:resource="http://onto-finallife-uti.org/ontology#var_burden"/>
    <rdf:rest rdf:nodeID="N0259386e5f9041a6a68c7ad3f53484c0"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#VentilationStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Mechanical ventilation status</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#RespiratoryParameter"/>
    <rdfs:comment xml:lang="en">Invasive / non-invasive / oxygen therapy / high-flow / tracheostomy status with start-stop times. MIMIC-IV derived table: mimiciv_derived.ventilation.</rdfs:comment>
    <mimic:ventilation>mimiciv_derived.ventilation</mimic:ventilation>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nb0ed9d97df6f46489a35cf403c5f1652">
    <rdf:first rdf:nodeID="Na3a9a7b276154660a2df404ac8c3de0a"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#hasAgent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://onto-finallife-uti.org/ontology#DecisionProcess"/>
