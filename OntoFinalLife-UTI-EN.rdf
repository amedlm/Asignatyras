  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#Patient_ICU">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">ICU patient</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#ClinicalEntity"/>
    <rdfs:comment xml:lang="en">A patient admitted to the Intensive Care Unit.</rdfs:comment>
    <skos:exactMatch rdf:resource="http://snomed.info/id/116154003"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#NonMaleficence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
