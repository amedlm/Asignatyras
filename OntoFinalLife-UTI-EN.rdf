    <rdfs:label xml:lang="en">Decision timestamp</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#TemporalEntity"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2006/time#Instant"/>
    <rdfs:comment xml:lang="en">The instant in time at which a decision was formally made and recorded.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N6ad604d0af8743e5a74c7b01cff823a8">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
