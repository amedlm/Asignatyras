  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#FamilyMember">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Family member</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#Agent"/>
    <rdfs:comment xml:lang="en">A relative or other person close to the patient who may participate in shared decision-making, especially when the patient lacks capacity.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Na3a9a7b276154660a2df404ac8c3de0a">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
    <swrl:propertyPredicate rdf:resource="http://onto-finallife-uti.org/ontology#hasPatientPreference"/>
    <swrl:argument1 rdf:resource="http://onto-finallife-uti.org/ontology#var_p"/>
    <swrl:argument2 rdf:resource="http://onto-finallife-uti.org/ontology#var_v1"/>
  </rdf:Description>
