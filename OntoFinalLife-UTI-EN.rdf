    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#ClinicalState"/>
    <rdfs:comment xml:lang="en">Inferred by Rule 1 when the survival probability is below 0.01.</rdfs:comment>
  </rdf:Description>
