  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#RespiratoryFailure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Respiratory failure</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#OrganFailure"/>
    <rdfs:comment xml:lang="en">Inadequate gas exchange requiring oxygen therapy or mechanical ventilation.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#MELDScore">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">MELD score (Model for End-Stage Liver Disease)</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#OrganSpecificStagingScale"/>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#HepaticFailure"/>
    <rdfs:comment xml:lang="en">Hepatic organ-failure staging score. MIMIC-IV derived table: mimiciv_derived.meld.</rdfs:comment>
    <mimic:meld>mimiciv_derived.meld</mimic:meld>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#hasValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#var_cs">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nf5c9779cb9d24926b05e32b5247f4bdd">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
    <swrl:classPredicate rdf:resource="http://onto-finallife-uti.org/ontology#Patient_ICU"/>
    <swrl:argument1 rdf:resource="http://onto-finallife-uti.org/ontology#var_p"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#SerumCreatinine">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Serum creatinine</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#RenalBiomarker"/>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#LaboratoryTest"/>
    <skos:exactMatch rdf:resource="http://loinc.org/2160-0"/>
    <mimic:chemistry>mimiciv_derived.chemistry</mimic:chemistry>
    <rdfs:comment xml:lang="en">Blood concentration of creatinine, the standard laboratory marker of renal filtration function.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N4f8eac5e683f451dbd3f92f12665e8f4">
    <rdf:first rdf:nodeID="N1690ef3c6f5d45faad373653d02b3b12"/>
    <rdf:rest rdf:nodeID="N84ad488c90074a809dc55d7bb223cdd7"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#RequiresReevaluation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Decision requiring re-evaluation</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#Decision"/>
    <rdfs:comment xml:lang="en">A decision flagged as needing to be revisited because its re-evaluation threshold has elapsed (output of Rule 14).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#OASISScore">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">OASIS score (Oxford Acute Severity of Illness Score)</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#SeverityScore"/>
    <rdfs:comment xml:lang="en">MIMIC-IV derived table: mimiciv_derived.oasis.</rdfs:comment>
    <mimic:oasis>mimiciv_derived.oasis</mimic:oasis>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#DocumentedValueAlignment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Documented value alignment</rdfs:label>
    <rdfs:comment xml:lang="en">A recorded confirmation that a patient's expressed value is compatible with their current clinical state (output of Rule 21).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#kdigo_CarlosM">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://onto-finallife-uti.org/ontology#KDIGOStage"/>
    <rdfs:comment xml:lang="en">AKI stage consistent with creatinine 3.2 mg/dL.</rdfs:comment>
    <hasSeverityScoreValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">3.0</hasSeverityScoreValue>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Na2ad2c2faa994d64933035669638042b">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
    <swrl:propertyPredicate rdf:resource="http://onto-finallife-uti.org/ontology#hasClinicalState"/>
    <swrl:argument1 rdf:resource="http://onto-finallife-uti.org/ontology#var_p"/>
    <swrl:argument2 rdf:resource="http://onto-finallife-uti.org/ontology#var_cs"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#VasoactiveDose">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Vasoactive drug dose</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#ClinicalAnalysis"/>
    <rdfs:comment xml:lang="en">The administered dose of a vasoactive (vasopressor or inotropic) medication.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#charlson_CarlosM">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://onto-finallife-uti.org/ontology#CharlsonComorbidityIndex"/>
    <rdfs:comment xml:lang="en">Chronic COPD contributes to the comorbidity burden.</rdfs:comment>
    <hasSeverityScoreValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">5.0</hasSeverityScoreValue>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nc8c66386d7ee4a8dbfc22b4932546de1">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#BuiltinAtom"/>
    <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#differentFrom"/>
    <swrl:arguments rdf:nodeID="N1741d0c0fa7a4e2ab4f6721adedc7947"/>
