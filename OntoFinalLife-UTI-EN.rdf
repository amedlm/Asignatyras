  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#APSIIIScore">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">APS-III score (Acute Physiology Score III, APACHE III component)</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#SeverityScore"/>
    <rdfs:comment xml:lang="en">Acute physiology component of APACHE III. MIMIC-IV derived table: mimiciv_derived.apsiii.</rdfs:comment>
    <mimic:apsiii>mimiciv_derived.apsiii</mimic:apsiii>
    <rdfs:seeAlso rdf:resource="http://onto-finallife-uti.org/ontology#APACHEIIScore"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N73d117f8a29943e79b89badf5bc5d645">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
    <swrl:propertyPredicate rdf:resource="http://onto-finallife-uti.org/ontology#hasAgent"/>
