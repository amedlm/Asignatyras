  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#Decision">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Decision</rdfs:label>
    <rdfs:comment xml:lang="en">The formal outcome of a decision process, e.g. to limit, continue, or withdraw a treatment.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N2dfe94b3d448410bb68f88ed26f95e44">
    <rdf:first rdf:resource="http://onto-finallife-uti.org/ontology#var_elapsed"/>
