    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#HealthcareProfessional"/>
    <rdfs:comment xml:lang="en">An allied health professional who supports the patient's family and helps coordinate psychosocial and discharge-planning needs.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#Situation_Futility">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
