  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#FunctionalStatusScale">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Functional / performance status scale</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#ClinicalAnalysis"/>
    <rdfs:comment xml:lang="en">Assesses a patient's baseline functional capacity independent of the acute ICU episode; used mainly in the evaluative (quality-of-life) dimension rather than acute severity scoring.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#Rule1_TherapeuticFutility">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label xml:lang="en">Rule 1: Identification of therapeutic futility</rdfs:label>
    <rdfs:comment>Patient_ICU(?p) ^ hasClinicalState(?p,?cs) ^ hasReversalPotential(?cs,false) ^ hasPrognosis(?p,?pr) ^ hasSurvivalProbability(?pr,?prob) ^ swrlb:lessThan(?prob,0.01) -&gt; Situation_Futility(?cs)</rdfs:comment>
  </rdf:Description>
