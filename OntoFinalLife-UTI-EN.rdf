    <rdfs:label xml:lang="en">SOFA score (Sequential Organ Failure Assessment)</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#SeverityScore"/>
    <rdfs:comment xml:lang="en">Six-organ-system dysfunction score, computed hourly over a 24h window. MIMIC-IV derived table: mimiciv_derived.sofa. Reference: Vincent et al., 1996.</rdfs:comment>
    <mimic:sofa>mimiciv_derived.sofa</mimic:sofa>
