  </rdf:Description>
  <rdf:Description rdf:nodeID="Nda1eddb7df9541a7b7e72aa701c84e62">
    <rdf:first rdf:nodeID="Nbcbad25ffaae44a5bd88234f2109373b"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#Rule11_SpecificTreatmentLimitation">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label xml:lang="en">Rule 11: Specific treatment limitation</rdfs:label>
    <rdfs:comment>Patient_ICU(?p) ^ Situation_Futility(?cs) ^ hasTreatmentOption(?p,?opt) ^ hasProbabilitySurvival(?opt,?prob) ^ swrlb:lessThan(?prob,0.01) -&gt; LimitTreatment(?opt)</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N809bd3467f2b4caca49b52dcef288b38">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
    <swrl:classPredicate rdf:resource="http://onto-finallife-uti.org/ontology#CompleteDocumentation"/>
    <swrl:argument1 rdf:resource="http://onto-finallife-uti.org/ontology#var_dp"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N3da87f2c2c5941bea49708980ecc2dfa">
    <rdf:first rdf:nodeID="N438c691c6724479d97a08d88a6ac4244"/>
    <rdf:rest rdf:nodeID="Ncc426e9873d347c09cb40c4025020f08"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nb854ab957ae8414c9d65b05261235997">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
    <swrl:propertyPredicate rdf:resource="http://onto-finallife-uti.org/ontology#hasPatientPreference"/>
    <swrl:argument1 rdf:resource="http://onto-finallife-uti.org/ontology#var_p"/>
    <swrl:argument2 rdf:resource="http://onto-finallife-uti.org/ontology#var_pref"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#InvasiveMechanicalVentilation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Invasive mechanical ventilation</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#TreatmentOption"/>
    <skos:exactMatch rdf:resource="http://snomed.info/id/40617009"/>
    <rdfs:comment xml:lang="en">Positive-pressure ventilatory support delivered through an endotracheal or tracheostomy tube.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N184bedf4241640e39ce5d8f5e0b514d4">
    <rdf:first rdf:nodeID="Nc222c5836bd244f9ab34877ed5ea062f"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N0a465f44a9e94a13a5aba0d3cbd0a24f">
    <rdf:first rdf:nodeID="N6b5a165749ae4430afa3e170750c949f"/>
    <rdf:rest rdf:nodeID="N007c3913758b4e11978f3d4f81d91608"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#Rule2_RefractorySuffering">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label xml:lang="en">Rule 2: Detection of refractory suffering</rdfs:label>
    <rdfs:comment>Patient_ICU(?p) ^ hasClinicalState(?p,?cs) ^ recordsRefractorySuffering(?cs,true) ^ hasSymptomBurden(?cs,?burden) ^ swrlb:greaterThan(?burden,7) -&gt; RefractorySufferingSituation(?cs)</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N94265d2174394136a2e42cdb8bd8cf4e">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
    <swrl:classPredicate rdf:resource="http://onto-finallife-uti.org/ontology#QualityDecision"/>
    <swrl:argument1 rdf:resource="http://onto-finallife-uti.org/ontology#var_dp"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#RequiresMediation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Requires mediation</rdfs:label>
    <rdfs:comment xml:lang="en">A disagreement between agents that has persisted across multiple consensus attempts and needs formal mediation (output of Rule 20).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#IndicatedPalliativeCare">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Indicated palliative care</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#PalliativeCare"/>
    <rdfs:comment xml:lang="en">The subset of palliative care recommended for a specific patient once refractory suffering and irreversibility have been established (output of Rule 10).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nec85a1e96a144289ad37d6b479d51f12">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
    <swrl:classPredicate rdf:resource="http://onto-finallife-uti.org/ontology#ValuesAlignedOption"/>
    <swrl:argument1 rdf:resource="http://onto-finallife-uti.org/ontology#var_opt"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Ne8c00e0e6dee4c29b6ff3006bb761aa9">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
    <swrl:classPredicate rdf:resource="http://onto-finallife-uti.org/ontology#EvidenceBasedRecommendation"/>
    <swrl:argument1 rdf:resource="http://onto-finallife-uti.org/ontology#var_rec"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#creatinine_CarlosM">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://onto-finallife-uti.org/ontology#SerumCreatinine"/>
    <rdfs:comment xml:lang="en">3.2 mg/dL</rdfs:comment>
    <hasBiomarkerValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">3.2</hasBiomarkerValue>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Na5a83311f3be4e3cbb65a7197a7ad0f9">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
    <swrl:classPredicate rdf:resource="http://onto-finallife-uti.org/ontology#Patient_ICU"/>
    <swrl:argument1 rdf:resource="http://onto-finallife-uti.org/ontology#var_p"/>
  </rdf:Description>
