    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#TreatmentOption"/>
    <rdfs:comment xml:lang="en">A decision to withhold or withdraw a specific treatment option because it no longer offers meaningful benefit (the ontology's term for LET, limitation of therapeutic effort).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#TreatmentWindow">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Treatment window</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#TemporalEntity"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2006/time#Interval"/>
    <rdfs:comment xml:lang="en">Time interval during which a treatment option remains clinically viable (used in Rule 8).</rdfs:comment>
  </rdf:Description>
