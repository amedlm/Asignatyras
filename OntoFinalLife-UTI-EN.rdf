    <swrl:argument2 rdf:resource="http://onto-finallife-uti.org/ontology#var_a"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Ne85de7296d354b74b73b21426a410503">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
    <swrl:propertyPredicate rdf:resource="http://onto-finallife-uti.org/ontology#hasDecisionProcess"/>
    <swrl:argument1 rdf:resource="http://onto-finallife-uti.org/ontology#var_p"/>
    <swrl:argument2 rdf:resource="http://onto-finallife-uti.org/ontology#var_dp"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N833a6f02e8ac488b98e528d2eebe4c15">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
    <swrl:propertyPredicate rdf:resource="http://onto-finallife-uti.org/ontology#documentedBy"/>
    <swrl:argument1 rdf:resource="http://onto-finallife-uti.org/ontology#var_d"/>
    <swrl:argument2 rdf:resource="http://onto-finallife-uti.org/ontology#var_dp"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#EndOfLifeCareOrder">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">End-of-life care order / code status</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#ClinicalAnalysis"/>
    <rdfs:comment xml:lang="en">Documented resuscitation and life-support preference order, directly operationalising the ethical/evaluative dimension inside the clinical record.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Na658ec1f9af4469e84f2a56f5a01f913">
    <rdf:first rdf:nodeID="Ne8deee54bddc4d48bb89b5e5dcf442c0"/>
    <rdf:rest rdf:nodeID="N2d40053a7fbb46c19b3764f07651c803"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#ValuesAlignedOption">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Values-aligned treatment option</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#TreatmentOption"/>
    <rdfs:comment xml:lang="en">A treatment option confirmed compatible with the patient's expressed values (output of Rule 6).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#CharlsonComorbidityIndex">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Charlson Comorbidity Index (CCI)</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#ComorbidityIndex"/>
    <rdfs:comment xml:lang="en">Weighted comorbidity burden index derived from ICD-9/ICD-10 diagnosis codes. MIMIC-IV derived table: mimiciv_derived.charlson. Reference: Charlson et al., 1987.</rdfs:comment>
    <mimic:charlson>mimiciv_derived.charlson</mimic:charlson>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#generatesAuditTrail">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://onto-finallife-uti.org/ontology#DecisionProcess"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#Rule15_SWRL">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label xml:lang="en">Rule 15 (RDF/SWRL): Documentation completeness check</rdfs:label>
    <swrl:body rdf:nodeID="Nfb585c7dfc3344dd90f2bf5d37ca75e3"/>
    <swrl:head rdf:nodeID="Nc9cdc60f4c16430caf2d658f597a1444"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#LaboratoryTest">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Laboratory test</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#ClinicalAnalysis"/>
    <skos:exactMatch rdf:resource="http://loinc.org"/>
    <rdfs:comment xml:lang="en">Any quantitative test performed on a biological sample (blood, urine, etc.) in a clinical laboratory.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Ncffb3cff61294a5dbee0247cbd63e5e7">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
    <swrl:propertyPredicate rdf:resource="http://onto-finallife-uti.org/ontology#hasDecision"/>
    <swrl:argument1 rdf:resource="http://onto-finallife-uti.org/ontology#var_dp"/>
    <swrl:argument2 rdf:resource="http://onto-finallife-uti.org/ontology#var_d"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#TreatmentOption">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Treatment option</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#ClinicalEntity"/>
    <rdfs:comment xml:lang="en">Any intervention the clinical team could offer or withhold, from full life support to comfort-only care; the object of most limitation-of-treatment decisions.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#Guardianship">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Guardianship / legal representation</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#LegalEntity"/>
    <rdfs:comment xml:lang="en">A legal arrangement under which a designated person is authorised to make healthcare decisions on behalf of a patient who lacks capacity.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#RenalReplacementTherapy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Renal replacement therapy</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#TreatmentOption"/>
    <rdfs:comment xml:lang="en">Dialysis or continuous renal replacement therapy used to substitute for lost kidney function.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N94fcc7bb18e44d36817bc0fadb3b5c0e">
    <rdf:first rdf:nodeID="Nb854ab957ae8414c9d65b05261235997"/>
    <rdf:rest rdf:nodeID="Nc7c1ff55b9cf4390830c36d72aad9c05"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nfec7e1afe2b64e5eab2b9472da685edc">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
    <swrl:propertyPredicate rdf:resource="http://onto-finallife-uti.org/ontology#hasGuidelineRecommendation"/>
    <swrl:argument1 rdf:resource="http://onto-finallife-uti.org/ontology#var_cs"/>
    <swrl:argument2 rdf:resource="http://onto-finallife-uti.org/ontology#var_rec"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#NorepinephrineDose">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Norepinephrine dose</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#VasoactiveDose"/>
    <rdfs:comment xml:lang="en">The administered dose of norepinephrine specifically, the first-line vasopressor in septic shock.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#Rule6_OptionValueCompatibility">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label xml:lang="en">Rule 6: Option-value compatibility</rdfs:label>
    <rdfs:comment>Patient_ICU(?p) ^ hasAdvanceDirective(?p,?ad) ^ expressesPreference(?ad,?val) ^ hasTreatmentOption(?p,?opt) ^ compatibleWith(?opt,?val) -&gt; ValuesAlignedOption(?opt)</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#Rule8_SWRL">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label xml:lang="en">Rule 8 (RDF/SWRL): Determination of urgency level</rdfs:label>
    <swrl:body rdf:nodeID="Nb00c2a8a59324d1e8a2cf9aa81174deb"/>
    <swrl:head rdf:nodeID="N4987e5a86d414ae2ac78e08c1646c8f0"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#QualityDecision">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Quality decision</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#Decision"/>
    <rdfs:comment xml:lang="en">A decision that meets the ontology's quality bar: reached by consensus, ethically consistent, and clinically aligned (output of Rule 13).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N6085d5faf72f40be91430a2d59fc9a29">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
    <swrl:propertyPredicate rdf:resource="http://onto-finallife-uti.org/ontology#hasDecisionProcess"/>
    <swrl:argument1 rdf:resource="http://onto-finallife-uti.org/ontology#var_p"/>
    <swrl:argument2 rdf:resource="http://onto-finallife-uti.org/ontology#var_dp"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#RenalFailure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Renal failure</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#OrganFailure"/>
    <rdfs:comment xml:lang="en">Inadequate kidney function, commonly staged in this ontology via the KDIGO scale.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#Rule9_SWRL">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label xml:lang="en">Rule 9 (RDF/SWRL): Documentation of the decision process</rdfs:label>
