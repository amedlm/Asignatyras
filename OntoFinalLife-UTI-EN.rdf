  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#ComfortMeasures">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Comfort measures</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#TreatmentOption"/>
    <rdfs:comment xml:lang="en">Concrete nursing and medical actions (analgesia, sedation, positioning, family presence) aimed purely at patient comfort once curative treatment has been limited.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#AccountabilityProtocol">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Accountability protocol</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#LegalEntity"/>
    <rdfs:comment xml:lang="en">Defines who ultimately decides when the ontology's recommendation and the clinical team's judgement disagree (limitation discussed in the source article, Section 8.3).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#DecisionProcess1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://onto-finallife-uti.org/ontology#DecisionProcess"/>
    <hasAgent rdf:resource="http://onto-finallife-uti.org/ontology#Maria"/>
    <hasAgent rdf:resource="http://onto-finallife-uti.org/ontology#ICU_Team"/>
    <produces rdf:resource="http://onto-finallife-uti.org/ontology#Decision_Withdrawal_CarlosM"/>
    <requiresConsultation rdf:resource="http://onto-finallife-uti.org/ontology#ClinicalEthicsCommittee"/>
  </rdf:Description>
