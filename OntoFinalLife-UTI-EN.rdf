  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#Rule17_ValuePrioritization">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label xml:lang="en">Rule 17: Prioritizing value in conflict</rdfs:label>
    <rdfs:comment>Patient_ICU(?p) ^ ValueConflict(?conflict) ^ hasValue(?conflict,?v1) ^ hasValue(?conflict,?v2) ^ hasPriority(?v1,'high') ^ hasPatientPreference(?p,?v1) -&gt; PrioritizeValue(?v1)</rdfs:comment>
  </rdf:Description>
