  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#LODSScore">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">LODS score (Logistic Organ Dysfunction System)</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#SeverityScore"/>
    <rdfs:comment xml:lang="en">MIMIC-IV derived table: mimiciv_derived.lods.</rdfs:comment>
