  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#Rule9_ProcessDocumentation">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label xml:lang="en">Rule 9: Documentation of the decision process</rdfs:label>
    <rdfs:comment>Patient_ICU(?p) ^ hasDecisionProcess(?p,?dp) ^ hasAgent(?dp,?a) ^ hasTimestamp(?dp,?t) ^ hasDecision(?dp,?d) -&gt; documentedBy(?d,?dp)</rdfs:comment>
  </rdf:Description>
