# ─────────────────────────────────────────────────────────────
# .gitignore — Repositorio Análisis Documental I (UCLV)
# Optimizado para: MARC 21, Dublin Core, Python, IDEs
# ─────────────────────────────────────────────────────────────

# ─── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ─── Virtualenv ─────────────────────────────────────────────
venv/
env/
ENV/
env.bak/
venv.bak/
.venv/
.python-version

# ─── Jupyter Notebook ──────────────────────────────────────
.ipynb_checkpoints
*/.ipynb_checkpoints/*
*.ipynb_checkpoints

# ─── MARC 21 / MARCXML ──────────────────────────────────────
# Los registros .mrc y .xml son contenido del curso: NO ignorar.
# Pero sí ignorar archivos temporales de pymarc:
*.bak.mrc
marc_temp/

# ─── ABCD / ISIS ────────────────────────────────────────────
abcd/data/*.msn
abcd/data/*.ifp
abcd/locks/
abcd/log/
# Mantener .iso (ISO-2709) y .mst - son contenido del curso

# ─── Editores e IDEs ────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject
.settings/
*.sublime-workspace
*.sublime-project

# ─── OS metadata ────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ─── PDFs generados automáticamente ────────────────────────
teoria/*.aux
teoria/*.log
teoria/*.out
teoria/*.toc

# ─── Estudiantes: entregas locales ───────────────────────────
entregas/
mi-entrega/
soluciones-propias/

# ─── Secretos y credenciales ────────────────────────────────
.env
.env.local
*.pem
*.key
credentials.json
token.json

# ─── Logs ───────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
