  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#Rule5_NonMaleficenceViolation">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label xml:lang="es">Regla 5: Detección de violación de no maleficencia</rdfs:label>
    <rdfs:comment>Patient_ICU(?p) ∧ hasTreatmentOption(?p,?opt) ∧ hasRiskOfHarm(?opt,?harm) ∧ hasSeverity(?harm,'high') ∧ hasBenefit(?opt,?ben) ∧ swrlb:lessThan(?ben,?harm) → PrincipleViolation(?conflict)</rdfs:comment>
  </rdf:Description>
