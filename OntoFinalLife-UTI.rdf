  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#Rule8_UrgencyLevel">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label xml:lang="es">Regla 8: Determinación del nivel de urgencia</rdfs:label>
    <rdfs:comment>Patient_ICU(?p) ∧ hasClinicalState(?p,?cs) ∧ hasReversalPotential(?cs,true) ∧ hasTimeWindow(?cs,?tw) ∧ swrlb:lessThan(?tw,24) → hasUrgency(?p,'emergency')</rdfs:comment>
