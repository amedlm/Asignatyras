  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dc:title>OntoFinalLife-UTI: Ontología Clínico-Ética Integrada para Decisiones de Final de Vida en UCI</dc:title>
    <dc:creator>Amed Leiva Mederos</dc:creator>
    <dc:creator>José Antonio Senso Ruíz</dc:creator>
    <dc:creator>Fernando Ortiz Rodriguez</dc:creator>
    <dc:creator>Armando David Caballero Font</dc:creator>
    <dc:creator>María Matilde García Lorenzo</dc:creator>
    <dc:creator>Rafael Bello Pérez</dc:creator>
    <dc:creator>Lisandra Díaz de la Paz</dc:creator>
    <dc:creator>Daniel Gálvez Lio</dc:creator>
    <rdfs:comment>Ontología OWL 2 DL (perfil EL++) que integra la dimensión clínica objetiva,
la dimensión ética normativa y la dimensión evaluativa personal para decisiones de
limitación del esfuerzo terapéutico en UCI. Reutiliza SNOMED CT, LOINC, ICNP, TIME
Ontology y PROV-O, e incorpora 21 reglas SWRL organizadas en 6 categorías funcionales.</rdfs:comment>
    <owl:imports rdf:resource="http://www.w3.org/2006/time"/>
    <owl:imports rdf:resource="http://www.w3.org/ns/prov-o"/>
    <owl:versionInfo>1.0 - basado en el manuscrito OntoFinalLife-UTI</owl:versionInfo>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#CarlosM">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://onto-finallife-uti.org/ontology#Patient_ICU"/>
    <rdfs:label xml:lang="es">Carlos M.</rdfs:label>
    <rdfs:comment>Paciente de 78 años, EPOC terminal, 14 días en UCI, SDRA refractario y fallo multiorgánico.</rdfs:comment>
    <hasClinicalState rdf:resource="http://onto-finallife-uti.org/ontology#cs1"/>
    <hasPrognosis rdf:resource="http://onto-finallife-uti.org/ontology#pr1"/>
    <hasAdvanceDirective rdf:resource="http://onto-finallife-uti.org/ontology#AD_CarlosM"/>
    <hasTreatmentOption rdf:resource="http://onto-finallife-uti.org/ontology#CurrentVentilation"/>
    <hasAnalysis rdf:resource="http://onto-finallife-uti.org/ontology#sofa_CarlosM"/>
    <hasAnalysis rdf:resource="http://onto-finallife-uti.org/ontology#creatinine_CarlosM"/>
    <hasAnalysis rdf:resource="http://onto-finallife-uti.org/ontology#bilirubin_CarlosM"/>
    <hasAnalysis rdf:resource="http://onto-finallife-uti.org/ontology#lactate_CarlosM"/>
    <hasAnalysis rdf:resource="http://onto-finallife-uti.org/ontology#fio2_CarlosM"/>
    <hasAnalysis rdf:resource="http://onto-finallife-uti.org/ontology#peep_CarlosM"/>
    <hasAnalysis rdf:resource="http://onto-finallife-uti.org/ontology#norepi_CarlosM"/>
  </rdf:Description>
