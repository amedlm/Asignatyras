  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#Rule4_AutonomyBeneficenceConflict">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label xml:lang="es">Regla 4: Detección de conflicto autonomía-beneficencia</rdfs:label>
    <rdfs:comment>Patient_ICU(?p) ∧ expressesValue(?p,?val1) ∧ hasPrinciple(?val1,Autonomy) ∧ hasTreatmentOption(?p,?opt) ∧ basedOnPrinciple(?opt,Beneficence) ∧ incompatibleWith(?opt,?val1) → ValueConflict(?conflict)</rdfs:comment>
