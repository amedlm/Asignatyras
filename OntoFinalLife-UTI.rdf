  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#TreatmentWindow">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="es">Ventana terapéutica</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#TemporalEntity"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2006/time#Interval"/>
    <rdfs:comment xml:lang="es">Intervalo temporal durante el cual una opción de tratamiento es clínicamente viable (usado en Regla 8).</rdfs:comment>
    <rdfs:comment xml:lang="es">Se relaciona con time:hasBeginning y time:hasDuration para expresar el inicio y la duración disponible antes de que una opción terapéutica deje de ser viable.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#Rule7_EthicsCommitteeActivation">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label xml:lang="es">Regla 7: Activación de consulta al comité de ética</rdfs:label>
    <rdfs:comment>Patient_ICU(?p) ∧ hasDecisionProcess(?p,?dp) ∧ hasDisagreementWith(?dp,?agent) ∧ hasSeverity(?dp,'high') → requiresConsultation(?dp, EthicsCommittee)</rdfs:comment>
  </rdf:Description>
