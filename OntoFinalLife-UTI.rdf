  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#Rule2_RefractorySuffering">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label xml:lang="es">Regla 2: Detección de sufrimiento refractario</rdfs:label>
    <rdfs:comment>Patient_ICU(?p) ∧ hasClinicalState(?p,?cs) ∧ recordsRefractorySuffering(?cs,true) ∧ hasSymptomBurden(?cs,?burden) ∧ swrlb:greaterThan(?burden,7) → RefractorySufferingSituation(?cs)</rdfs:comment>
  </rdf:Description>
