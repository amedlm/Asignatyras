    <rdfs:label xml:lang="es">Regla 10: Indicación de cuidados paliativos intensivos</rdfs:label>
    <rdfs:comment>Patient_ICU(?p) ∧ hasClinicalState(?p,?cs) ∧ RefractorySufferingSituation(?cs) ∧ hasReversalPotential(?cs,false) → IndicatedPalliativeCare(?p)</rdfs:comment>
  </rdf:Description>
