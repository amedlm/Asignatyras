  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#Rule1_TherapeuticFutility">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label xml:lang="es">Regla 1: Identificación de futilidad terapéutica</rdfs:label>
    <rdfs:comment>Patient_ICU(?p) ∧ hasClinicalState(?p,?cs) ∧ hasReversalPotential(?cs,false) ∧ hasPrognosis(?p,?pr) ∧ hasSurvivalProbability(?pr,?prob) ∧ swrlb:lessThan(?prob,0.01) → Situation_Futility(?cs)</rdfs:comment>
