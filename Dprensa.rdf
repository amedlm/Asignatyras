    <!-- http://example.org/ontologies/dspace#Caricatura -->

    <owl:Class rdf:about="http://example.org/ontologies/dspace#Caricatura">
        <rdfs:subClassOf rdf:resource="http://example.org/ontologies/dspace#Imagen"/>
        <rdfs:label xml:lang="es">Caricatura</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/ontologies/dspace#Edicion -->

    <owl:Class rdf:about="http://example.org/ontologies/dspace#Edicion">
        <rdfs:subClassOf rdf:resource="http://example.org/ontologies/dspace#PublicacionSeriada"/>
        <rdfs:comment xml:lang="es">Conjunto de volúmenes y números que se publican en una Publicación Seriada</rdfs:comment>
        <rdfs:label xml:lang="es">Edición</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/ontologies/dspace#Fotografia -->

    <owl:Class rdf:about="http://example.org/ontologies/dspace#Fotografia">
        <rdfs:subClassOf rdf:resource="http://example.org/ontologies/dspace#Imagen"/>
        <rdfs:label xml:lang="es">Fotografía</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/ontologies/dspace#Imagen -->

    <owl:Class rdf:about="http://example.org/ontologies/dspace#Imagen">
        <rdfs:subClassOf rdf:resource="http://example.org/ontologies/dspace#ObjetoDigital"/>
        <rdfs:comment xml:lang="es">Fotografías y caricaturas exclusivas de los medios de prensa</rdfs:comment>
        <rdfs:label xml:lang="es">Imagen</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/ontologies/dspace#MaterialPeriodistico -->

    <owl:Class rdf:about="http://example.org/ontologies/dspace#MaterialPeriodistico">
        <rdfs:subClassOf rdf:resource="http://example.org/ontologies/dspace#ObjetoDigital"/>
        <rdfs:comment xml:lang="es">Contenidos periodísticos fundamentales publicados en una Edición</rdfs:comment>
        <rdfs:label xml:lang="es">Material Periodístico</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/ontologies/dspace#Monografia -->

    <owl:Class rdf:about="http://example.org/ontologies/dspace#Monografia">
        <rdfs:subClassOf rdf:resource="http://example.org/ontologies/dspace#ObjetoDigital"/>
        <rdfs:comment xml:lang="es">Publicación no seriada, publicada de principio a fin, independientemente de la extensión</rdfs:comment>
        <rdfs:label xml:lang="es">Monografía</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/ontologies/dspace#ObjetoDigital -->

    <owl:Class rdf:about="http://example.org/ontologies/dspace#ObjetoDigital">
        <rdfs:label xml:lang="es">Objeto Digital</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/ontologies/dspace#Organizacion -->

    <owl:Class rdf:about="http://example.org/ontologies/dspace#Organizacion">
        <rdfs:subClassOf rdf:resource="http://xmlns.com/foaf/0.1/Organization"/>
        <rdfs:label xml:lang="es">Organización</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/ontologies/dspace#Persona -->

    <owl:Class rdf:about="http://example.org/ontologies/dspace#Persona">
        <rdfs:subClassOf rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
        <rdfs:label xml:lang="es">Persona</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/ontologies/dspace#PublicacionSeriada -->

    <owl:Class rdf:about="http://example.org/ontologies/dspace#PublicacionSeriada">
        <rdfs:subClassOf rdf:resource="http://example.org/ontologies/dspace#ObjetoDigital"/>
        <rdfs:comment xml:lang="es">Conjunto de títulos de publicaciones con salida periódica. Conjunto de títulos de publicaciones (nivel monográfico), tengan salida periódica, o sea, sus volúmenes o números se suceden en orden numérico o cronológico, bajo un título común y en numero indefinido, con una periodicidad fijada y  cuyo formato original sea impreso.</rdfs:comment>
        <rdfs:label xml:lang="es">Publicación Seriada</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/ontologies/dspace#Suplemento -->

    <owl:Class rdf:about="http://example.org/ontologies/dspace#Suplemento">
        <rdfs:subClassOf rdf:resource="http://example.org/ontologies/dspace#ObjetoDigital"/>
        <rdfs:comment xml:lang="es">Publicación seriada subordinada a un título de Revista o Periódico. Tipo de publicación seriada pero siempre subordinado a un título de Revista o Periódico particular. Puede abordar temas particulares o editarse para un tipo de audiencia. Cuenta con número seriado y frecuencia propios, pero su relación de dependencia es necesario establecerla. Puede haber más de un Suplemento por publicación seriada. El modelo es para las versiones impresas.</rdfs:comment>
        <rdfs:label xml:lang="es">Suplemento</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/ontologies/dspace#VocabularioCOAR -->

    <owl:Class rdf:about="http://example.org/ontologies/dspace#VocabularioCOAR">
        <rdfs:label xml:lang="es">Vocabulario COAR</rdfs:label>
