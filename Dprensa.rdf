        <rdfs:range rdf:resource="http://example.org/ontologies/dspace#Edicion"/>
        <rdfs:label xml:lang="es">es parte de</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/ontologies/dspace#publicadoPor -->

