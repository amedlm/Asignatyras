    <j.23:url rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI"
    >http://dx.doi.org/10.14295/ambeduc.v25i1.11232</j.23:url>
                                                              </j.23:URL>
                                                            </j.23:hasURL>
