                                        <j.13:relatedBy>
                                          <j.13:Authorship rdf:about="http://vivo.uclv.edu.cu/individual/n911">
                                            <j.13:relates rdf:resource="http://vivo.uclv.edu.cu/individual/n7480"/>
                                            <j.13:relates>
                                              <j.23:Individual rdf:about="http://vivo.uclv.edu.cu/individual/n6472">
                                                <j.13:relatedBy rdf:resource="http://vivo.uclv.edu.cu/individual/n911"/>
                                                <j.23:hasName>
                                                  <j.23:Name rdf:about="http://vivo.uclv.edu.cu/individual/n3809">
                                                    <j.23:familyName
                                                    >Portal</j.23:familyName>
                                                    <j.23:givenName
                                                    >Orelvis</j.23:givenName>
