  <owl:Class rdf:about="http://purl.obolibrary.org/obo/IAO_0000032">
    <j.7:IAO_0000116 xml:lang="en">Would write this as: has_part some 'measurement unit label' and has_part some numeral and has_part exactly 2, except for the fact that this won't let us take advantage of OWL reasoning over the numbers. Instead use has measurment value property to represent the same. Use has measurement unit label (subproperty of has_part) so we can easily say that there is only one of them.</j.7:IAO_0000116>
    <j.7:IAO_0000117 xml:lang="en">PERSON: Melanie Courtot</j.7:IAO_0000117>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.obolibrary.org/obo/IAO_0000109"/>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="es">Datum de medición escalar</rdfs:label>
    <j.7:IAO_0000115 xml:lang="en">a scalar measurement datum is a measurement datum that is composed of two parts, numerals and a unit label.</j.7:IAO_0000115>
    <rdfs:label xml:lang="en">Scalar Measurement Datum</rdfs:label>
    <rdfs:label xml:lang="en-US">Scalar Measurement Datum</rdfs:label>
    <j.7:IAO_0000117 xml:lang="en">PERSON: Alan Ruttenberg</j.7:IAO_0000117>
    <j.7:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000120"/>
    <j.7:IAO_0000112 xml:lang="en">10 feet. 3 ml.</j.7:IAO_0000112>
    <j.7:IAO_0000116 xml:lang="en">2009-03-16: we decided to keep datum singular in scalar measurement datum, as in
this case we explicitly refer to the singular form</j.7:IAO_0000116>
  </owl:Class>
