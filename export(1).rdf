            </j.7:ARG_2000028>
            <j.13:relatedBy>
              <j.13:Authorship rdf:about="http://vivo.uclv.edu.cu/individual/n1720">
                <j.13:relates rdf:resource="http://vivo.uclv.edu.cu/individual/n3600"/>
                <j.13:relates>
                  <j.23:Individual rdf:about="http://vivo.uclv.edu.cu/individual/n4887">
                    <j.13:relatedBy rdf:resource="http://vivo.uclv.edu.cu/individual/n1720"/>
                    <j.23:hasName>
                      <j.23:Name rdf:about="http://vivo.uclv.edu.cu/individual/n14">
                        <j.23:familyName>Macías-Rodríguez</j.23:familyName>
                        <j.23:givenName>Edis</j.23:givenName>
                      </j.23:Name>
