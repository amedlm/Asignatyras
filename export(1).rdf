        <j.24:doi>10.1108/el-04-2014-0061</j.24:doi>
        <rdfs:label>Information skills training through mobile devices</rdfs:label>
        <j.24:pageStart>116</j.24:pageStart>
        <j.13:dateTimeValue>
          <j.13:DateTimeValue rdf:about="http://vivo.uclv.edu.cu/individual/n690">
            <j.13:dateTimePrecision>http://vivoweb.org/ontology/core#yearPrecision</j.13:dateTimePrecision>
            <j.13:dateTime>2016-01-01T00:00:00</j.13:dateTime>
          </j.13:DateTimeValue>
        </j.13:dateTimeValue>
        <j.24:pageEnd>131</j.24:pageEnd>
        <j.13:relatedBy>
          <j.13:Authorship rdf:about="http://vivo.uclv.edu.cu/individual/n4599">
            <j.13:relates rdf:resource="http://vivo.uclv.edu.cu/individual/n19095"/>
            <j.13:relates>
              <j.23:Individual rdf:about="http://vivo.uclv.edu.cu/individual/n0">
                <j.13:relatedBy rdf:resource="http://vivo.uclv.edu.cu/individual/n4599"/>
                <j.23:hasName>
                  <j.23:Name rdf:about="http://vivo.uclv.edu.cu/individual/n1081">
                    <j.23:familyName>Manso Rodríguez</j.23:familyName>
                    <j.23:givenName>Ramón Alberto</j.23:givenName>
                  </j.23:Name>
                </j.23:hasName>
              </j.23:Individual>
            </j.13:relates>
            <j.13:rank rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
