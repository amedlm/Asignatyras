                                                <j.13:relates>
                                                  <j.24:Article rdf:about="http://vivo.uclv.edu.cu/individual/n2291">
                                                    <j.13:relatedBy>
                                                      <j.13:Authorship rdf:about="http://vivo.uclv.edu.cu/individual/n7003">
