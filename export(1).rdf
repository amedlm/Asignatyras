    <j.16:descriptionAnnot xml:lang="es-GO"></j.16:descriptionAnnot>
    <j.16:descriptionAnnot xml:lang="en-US"></j.16:descriptionAnnot>
    <j.7:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000120"/>
    <j.7:IAO_0000116 xml:lang="en">The ObjectProperty relates is used to associate an AcademicDegree with an AwardedDegree.  A preferred
        approach would be to recognize the AwardedDegree as an information artifact which is the output of an AcademicDegree process.
        This would eliminate the use of relates and relatedBy in the
        representation of Academic Degrees and Awarded Degrees, provide correct subsumption, and avoid the use of vivo:Relationship. Further, we could
        rename AwardedDegree AcademicDegree (!) and rename AcademicDegree to AcademicDegreeProcess and eliminate the need for
        the EducationalProcess currently in the model.
        </j.7:IAO_0000116>
    <rdfs:label xml:lang="es-GO">Grado Académico</rdfs:label>
    <rdfs:label xml:lang="es">Grado académico</rdfs:label>
    <rdfs:label xml:lang="en-US">Grado Académico</rdfs:label>
    <j.7:IAO_0000115 xml:lang="en">An academic degree at any level, both as 
        reported by individuals for employment and as offered by academic degree programs.</j.7:IAO_0000115>
    <rdfs:label xml:lang="en">Academic Degree</rdfs:label>
