                                            <j.7:ARG_2000028>
                                              <j.23:Kind rdf:about="http://vivo.uclv.edu.cu/individual/n174">
                                                <j.7:ARG_2000029 rdf:resource="http://vivo.uclv.edu.cu/individual/n306"/>
