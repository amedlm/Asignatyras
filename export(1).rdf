                                <j.13:relatedBy>
                                  <j.13:FacultyPosition rdf:about="http://vivo.uclv.edu.cu/individual/n7203">
                                    <j.13:relates rdf:resource="http://vivo.uclv.edu.cu/individual/n7621"/>
                                    <rdfs:label>Profesor</rdfs:label>
                                    <rdf:type rdf:resource="http://vivoweb.org/ontology/core#Position"/>
