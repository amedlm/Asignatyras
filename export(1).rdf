    <j.7:IAO_0000115 xml:lang="en-US">A location having coordinates in geographic space.</j.7:IAO_0000115>
    <j.7:IAO_0000115>A location having coordinates in geographic space.</j.7:IAO_0000115>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://vivoweb.org/ontology/core#Location"/>
    </rdfs:subClassOf>
