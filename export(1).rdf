                                                <j.13:publisherOf rdf:resource="http://vivo.uclv.edu.cu/individual/n2083"/>
                                                <rdfs:label>FapUNIFESP (SciELO)</rdfs:label>
                                              </j.13:Publisher>
                                            </j.13:publisher>
                                            <j.24:issn>0103-3786</j.24:issn>
                                            <rdfs:label>Transinformação</rdfs:label>
                                          </j.24:Journal>
                                        </j.13:hasPublicationVenue>
                                        <j.24:numPages rdf:datatype=
                                        "http://www.w3.org/2001/XMLSchema#integer"
                                        >10</j.24:numPages>
