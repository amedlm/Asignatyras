      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <owl:Restriction>
            <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            <owl:onProperty>
              <owl:DatatypeProperty rdf:about="http://www.w3.org/2006/vcard/ns#nickName"/>
            </owl:onProperty>
          </owl:Restriction>
          <owl:Restriction>
            <owl:onProperty>
              <owl:DatatypeProperty rdf:about="http://www.w3.org/2006/vcard/ns#nickName"/>
            </owl:onProperty>
            <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
            >1</owl:minCardinality>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
    <rdfs:comment>Specifies the text corresponding to the nickname of the object the vCard represents</rdfs:comment>
