            <j.24:volume>12</j.24:volume>
            <rdfs:label>Influence of Acacia Mearnsii Fodder on Rumen Digestion and Mitigation of Greenhouse Gas Production</rdfs:label>
            <j.7:ARG_2000028>
              <j.23:Kind rdf:about="http://vivo.uclv.edu.cu/individual/n1014">
                <j.7:ARG_2000029 rdf:resource="http://vivo.uclv.edu.cu/individual/n3600"/>
