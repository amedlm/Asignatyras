            <j.13:dateTimeValue>
              <j.13:DateTimeValue rdf:about="http://vivo.uclv.edu.cu/individual/n3716">
                <j.13:dateTimePrecision>http://vivoweb.org/ontology/core#yearPrecision</j.13:dateTimePrecision>
