        <j.16:modTime rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime"
        >2023-08-12T18:50:12</j.16:modTime>
      </j.16:ClassGroup>
    </j.16:inClassGroup>
    <j.16:displayRankAnnot rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >1</j.16:displayRankAnnot>
