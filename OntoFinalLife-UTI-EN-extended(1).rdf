  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#Justice">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://onto-finallife-uti.org/ontology#EthicalPrinciple"/>
    <rdfs:label xml:lang="en">Justice</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#hasAnalysis">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://onto-finallife-uti.org/ontology#Patient_ICU"/>
    <rdfs:range rdf:resource="http://onto-finallife-uti.org/ontology#ClinicalAnalysis"/>
    <rdfs:label xml:lang="en">has clinical analysis</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#MOFStageIV">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">MOF stage IV (critical)</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#MOFSeverityStage"/>
    <rdfs:comment xml:lang="en">SOFA total score strictly greater than 12. Associated in-hospital mortality approximately &gt;80%; consistent with therapeutic-futility evaluation (Rule 1).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N8e3b6afe1098478db2042099a42c42f9">
