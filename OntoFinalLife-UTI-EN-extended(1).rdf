    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#LaboratoryTest"/>
    <skos:exactMatch rdf:resource="http://loinc.org/1975-2"/>
    <mimic:enzyme>mimiciv_derived.enzyme</mimic:enzyme>
