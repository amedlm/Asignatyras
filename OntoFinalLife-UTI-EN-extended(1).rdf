  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#Rule28_SWRL">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label xml:lang="en">Rule 28 (RDF/SWRL): Cause of death: refractory shock (lactate &gt; 4.0 mmol/L and NEE &gt;= 1.0 mcg/kg/min)</rdfs:label>
    <swrl:body rdf:nodeID="Nc39d0817441341089bab233930130fc7"/>
    <swrl:head rdf:nodeID="Nbfb0dbd3d88d4425a9384467e29457b8"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N4af192c4cd1940848d9a599cde0fc37f">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
    <swrl:propertyPredicate rdf:resource="http://onto-finallife-uti.org/ontology#hasClinicalAlignment"/>
    <swrl:argument1 rdf:resource="http://onto-finallife-uti.org/ontology#var_dp"/>
    <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrl:argument2>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#CardiopulmonaryResuscitation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Cardiopulmonary resuscitation (CPR)</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#TreatmentOption"/>
    <rdfs:comment xml:lang="en">Emergency procedure (chest compressions, defibrillation, advanced airway) performed in cardiac or respiratory arrest; withheld under a DNR code status.</rdfs:comment>
    <skos:exactMatch rdf:resource="http://snomed.info/id/89666000"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Neabe442c7db24eacb0e820e114f7edb2">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
    <swrl:propertyPredicate rdf:resource="http://onto-finallife-uti.org/ontology#hasAgent"/>
    <swrl:argument1 rdf:resource="http://onto-finallife-uti.org/ontology#var_p"/>
    <swrl:argument2 rdf:resource="http://onto-finallife-uti.org/ontology#var_a1"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N9fada8f21bf74b5bb0833002df82e16a">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
    <swrl:classPredicate rdf:resource="http://onto-finallife-uti.org/ontology#FiO2"/>
    <swrl:argument1 rdf:resource="http://onto-finallife-uti.org/ontology#var_f"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#Rule9_ProcessDocumentation">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label xml:lang="en">Rule 9: Documentation of the decision process</rdfs:label>
    <rdfs:comment>Patient_ICU(?p) ^ hasDecisionProcess(?p,?dp) ^ hasAgent(?dp,?a) ^ hasTimestamp(?dp,?t) ^ hasDecision(?dp,?d) -&gt; documentedBy(?d,?dp)</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N430a6583e7594e3bbd3cb1c9604d642a">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
    <swrl:propertyPredicate rdf:resource="http://onto-finallife-uti.org/ontology#hasCodeStatus"/>
    <swrl:argument1 rdf:resource="http://onto-finallife-uti.org/ontology#var_p"/>
    <swrl:argument2 rdf:resource="http://onto-finallife-uti.org/ontology#var_code"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N1e666f74a3e74922be38a0743885b5f9">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
    <swrl:propertyPredicate rdf:resource="http://onto-finallife-uti.org/ontology#expressesValue"/>
    <swrl:argument1 rdf:resource="http://onto-finallife-uti.org/ontology#var_a1"/>
    <swrl:argument2 rdf:resource="http://onto-finallife-uti.org/ontology#var_v1"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#Rule17_ValuePrioritization">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label xml:lang="en">Rule 17: Prioritizing value in conflict</rdfs:label>
    <rdfs:comment>Patient_ICU(?p) ^ ValueConflict(?conflict) ^ hasValue(?conflict,?v1) ^ hasValue(?conflict,?v2) ^ hasPriority(?v1,'high') ^ hasPatientPreference(?p,?v1) -&gt; PrioritizeValue(?v1)</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nbfa86dd38498467b9b59f559b08e8979">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
