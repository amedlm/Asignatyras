  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#CauseOfDeath_RefractoryRespFailure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://onto-finallife-uti.org/ontology#RefractoryRespiratoryFailureDeath"/>
    <rdfs:label xml:lang="en">Cause of death: refractory respiratory failure</rdfs:label>
    <rdfs:comment xml:lang="en">Canonical individual asserted by Rule 29 when FiO2 and PEEP both exceed the refractory-ARDS thresholds.</rdfs:comment>
  </rdf:Description>
