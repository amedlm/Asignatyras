    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://onto-finallife-uti.org/ontology#APSIIIScore"/>
    <rdfs:comment xml:lang="en">Illustrative APS-III value for the case, following mimiciv_derived.apsiii.</rdfs:comment>
    <hasSeverityScoreValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">78.0</hasSeverityScoreValue>
