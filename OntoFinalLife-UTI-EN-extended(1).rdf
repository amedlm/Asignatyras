  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#MOFSeverityStage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Multi-organ-failure severity stage</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#SeverityScore"/>
    <rdfs:comment xml:lang="en">SOFA-derived severity stage of multiple organ dysfunction, calculated by Rules 22-25 from the numeric SOFA total score. Stratifies patients into four bands of associated ICU mortality risk (Vincent et al., 1998 thresholds).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#Rule26_SWRL">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label xml:lang="en">Rule 26 (RDF/SWRL): Linking the patient to the computed MOF severity stage</rdfs:label>
    <swrl:body rdf:nodeID="Nce6c71fff45147c7834eefe04ea4cc8d"/>
    <swrl:head rdf:nodeID="N6ba5cfd261794410a66ead93d6da74d1"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#hasEthicalConsistency">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://onto-finallife-uti.org/ontology#DecisionProcess"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Ne003c773652448ef9027e5265ef53023">
