  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#KDIGOStage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">KDIGO AKI stage (Kidney Disease: Improving Global Outcomes)</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#OrganSpecificStagingScale"/>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#RenalFailure"/>
    <rdfs:comment xml:lang="en">Acute kidney injury staging (1-3) based on creatinine and urine output criteria. MIMIC-IV derived tables: mimiciv_derived.kdigo_stages, kdigo_creatinine, kdigo_uo.</rdfs:comment>
    <mimic:kdigo_stages>mimiciv_derived.kdigo_stages</mimic:kdigo_stages>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#OrganSpecificStagingScale">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Organ-specific staging scale</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#ClinicalAnalysis"/>
    <rdfs:comment xml:lang="en">A staging scale focused on a single organ system's degree of dysfunction, e.g. MELD for the liver or KDIGO for the kidney.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#hasValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#InstitutionalPolicy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Institutional policy</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#LegalEntity"/>
    <rdfs:comment xml:lang="en">A hospital- or unit-level policy governing how treatment-limitation decisions are made and documented.</rdfs:comment>
  </rdf:Description>
