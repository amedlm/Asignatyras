    <swrl:classPredicate rdf:resource="http://onto-finallife-uti.org/ontology#Patient_ICU"/>
    <swrl:argument1 rdf:resource="http://onto-finallife-uti.org/ontology#var_p"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#creatinine_CarlosM">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://onto-finallife-uti.org/ontology#SerumCreatinine"/>
    <rdfs:comment xml:lang="en">3.2 mg/dL</rdfs:comment>
    <hasBiomarkerValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">3.2</hasBiomarkerValue>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#Rule8_SWRL">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
