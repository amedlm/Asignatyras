  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#EthicalPrinciple">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Ethical principle</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#EthicalEntity"/>
    <rdfs:comment xml:lang="en">One of the four classical principles of biomedical ethics (autonomy, beneficence, non-maleficence, justice) used to justify or challenge a treatment option.</rdfs:comment>
  </rdf:Description>
