    <swrl:argument2 rdf:resource="http://onto-finallife-uti.org/ontology#var_cs"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#VasoactiveDose">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Vasoactive drug dose</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#ClinicalAnalysis"/>
    <rdfs:comment xml:lang="en">The administered dose of a vasoactive (vasopressor or inotropic) medication.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#Rule6_SWRL">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
