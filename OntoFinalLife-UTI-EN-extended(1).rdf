  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#Rule6_OptionValueCompatibility">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label xml:lang="en">Rule 6: Option-value compatibility</rdfs:label>
    <rdfs:comment>Patient_ICU(?p) ^ hasAdvanceDirective(?p,?ad) ^ expressesPreference(?ad,?val) ^ hasTreatmentOption(?p,?opt) ^ compatibleWith(?opt,?val) -&gt; ValuesAlignedOption(?opt)</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Na0feb3059e55466791164e4d42bae83c">
