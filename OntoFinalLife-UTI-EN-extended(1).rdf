  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#Rule30_CauseOfDeath_WithdrawalLST">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label xml:lang="en">Rule 30: Cause of death: withdrawal of life-sustaining treatment (futility + Comfort Measures Only)</rdfs:label>
    <rdfs:comment>Patient_ICU(?p) ^ hasClinicalState(?p,?cs) ^ Situation_Futility(?cs) ^ hasCodeStatus(?p,?code) ^ ComfortMeasuresOnly(?code) -&gt; hasCauseOfDeath(?p,CauseOfDeath_WithdrawalLST)</rdfs:comment>
  </rdf:Description>
