  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#NonInvasiveVentilation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Non-invasive ventilation (NIV)</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#TreatmentOption"/>
    <rdfs:comment xml:lang="en">Positive-pressure ventilatory support delivered via a face/nasal mask rather than an endotracheal tube; may be a ceiling-of-care alternative to invasive ventilation.</rdfs:comment>
    <skos:exactMatch rdf:resource="http://snomed.info/id/428311008"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N7410a12ebdd34ff69235d6982dbb18a2">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
    <swrl:propertyPredicate rdf:resource="http://onto-finallife-uti.org/ontology#hasPatientPreference"/>
