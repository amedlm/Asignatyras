  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#AntimicrobialTherapy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Antimicrobial therapy</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#TreatmentOption"/>
    <rdfs:comment xml:lang="en">Pharmacological treatment (antibiotics, antifungals, antivirals) targeting a suspected or confirmed infectious source of organ dysfunction.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#Rule12_ComfortMeasuresRecommendation">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label xml:lang="en">Rule 12: Recommendation of comfort measures</rdfs:label>
    <rdfs:comment>Patient_ICU(?p) ^ IndicatedPalliativeCare(?p) ^ hasSymptomBurden(?p,?burden) ^ swrlb:greaterThan(?burden,5) -&gt; ComfortMeasures(?p)</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Na0cc6cf42ce547c59342dbbd69381905">
