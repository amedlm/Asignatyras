    <swrl:argument2 rdf:resource="http://onto-finallife-uti.org/ontology#var_burden"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#Rule7_SWRL">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label xml:lang="en">Rule 7 (RDF/SWRL): Activation of ethics committee consultation</rdfs:label>
    <swrl:body rdf:nodeID="N4ea62e4607234cfaadd0bb0009ab60b0"/>
    <swrl:head rdf:nodeID="N01762bf7e6b146a69a457f7fabbc2108"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#Rule25_MOFStageIV_Calculation">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label xml:lang="en">Rule 25: Calculation of MOF stage IV (SOFA &gt;12)</rdfs:label>
    <rdfs:comment>Patient_ICU(?p) ^ hasAnalysis(?p,?s) ^ SOFAScore(?s) ^ hasSeverityScoreValue(?s,?v) ^ swrlb:greaterThan(?v,12.0) -&gt; MOFStageIV(?s)</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Na940390d5b4246439ca4b31da869338b">
    <rdf:first rdf:resource="http://onto-finallife-uti.org/ontology#var_elapsed"/>
    <rdf:rest rdf:nodeID="N5e0621c6644e4ec4b62928c4168786cc"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N4ea62e4607234cfaadd0bb0009ab60b0">
    <rdf:first rdf:nodeID="Ncdc7521e8e5c49d2bfdf5d618fa72b2a"/>
    <rdf:rest rdf:nodeID="N540713e9c09e4c23b9ec9d7edaa6641f"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nb7871a3921344ff6aa2b5c38b14829e9">
