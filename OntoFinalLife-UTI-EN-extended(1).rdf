  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#PEEP">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Positive end-expiratory pressure (PEEP)</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#RespiratoryParameter"/>
    <rdfs:comment xml:lang="en">The airway pressure maintained at the end of expiration during mechanical ventilation, used to keep alveoli open.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#Rule27_SWRL">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label xml:lang="en">Rule 27 (RDF/SWRL): Cause of death: irreversible multiple organ failure with withdrawal decision</rdfs:label>
    <swrl:body rdf:nodeID="N0b7b0e3c97b349c485c651249e9b8889"/>
    <swrl:head rdf:nodeID="N334e203992f847dbbc0b835c39371236"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#norepi_CarlosM">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://onto-finallife-uti.org/ontology#NorepinephrineDose"/>
    <hasBiomarkerValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.3</hasBiomarkerValue>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#karnofsky_CarlosM">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://onto-finallife-uti.org/ontology#KarnofskyPerformanceStatus"/>
    <rdfs:comment xml:lang="en">Baseline functional status prior to the acute ICU episode, as documented pre-admission.</rdfs:comment>
    <hasFunctionalStatusValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">40.0</hasFunctionalStatusValue>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#CauseOfDeath">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Cause of death</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#ClinicalEntity"/>
    <rdfs:comment xml:lang="en">Root class for the clinical circumstance directly responsible for the patient's death in the ICU. Used as the range of hasCauseOfDeath and as the inferred output of Rules 27-30.</rdfs:comment>
  </rdf:Description>
