  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#CauseOfDeath_MOF">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://onto-finallife-uti.org/ontology#MultipleOrganFailureDeath"/>
    <rdfs:label xml:lang="en">Cause of death: multiple organ failure</rdfs:label>
    <rdfs:comment xml:lang="en">Canonical individual asserted by Rule 27 when irreversible MOF plus a withdrawal decision are both present.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#bilirubin_CarlosM">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://onto-finallife-uti.org/ontology#TotalBilirubin"/>
    <rdfs:comment xml:lang="en">4.1 mg/dL</rdfs:comment>
    <hasBiomarkerValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">4.1</hasBiomarkerValue>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N9596877b0062494d9eeb5e917fb829d9">
    <rdf:first rdf:nodeID="Nba53806adcba46c48740e79b80787e4e"/>
