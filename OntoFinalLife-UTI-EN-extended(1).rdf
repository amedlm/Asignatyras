  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#CarlosM">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://onto-finallife-uti.org/ontology#Patient_ICU"/>
    <rdfs:label xml:lang="en">Carlos M.</rdfs:label>
    <rdfs:comment xml:lang="en">78-year-old patient with end-stage COPD, 14 days in the ICU, refractory ARDS and multiple organ failure.</rdfs:comment>
    <hasClinicalState rdf:resource="http://onto-finallife-uti.org/ontology#cs1"/>
    <hasPrognosis rdf:resource="http://onto-finallife-uti.org/ontology#pr1"/>
    <hasAdvanceDirective rdf:resource="http://onto-finallife-uti.org/ontology#AD_CarlosM"/>
    <hasTreatmentOption rdf:resource="http://onto-finallife-uti.org/ontology#CurrentVentilation"/>
    <hasCodeStatus rdf:resource="http://onto-finallife-uti.org/ontology#codestatus_CarlosM"/>
    <hasAnalysis rdf:resource="http://onto-finallife-uti.org/ontology#sofa_CarlosM"/>
    <hasAnalysis rdf:resource="http://onto-finallife-uti.org/ontology#apsiii_CarlosM"/>
    <hasAnalysis rdf:resource="http://onto-finallife-uti.org/ontology#sapsii_CarlosM"/>
    <hasAnalysis rdf:resource="http://onto-finallife-uti.org/ontology#charlson_CarlosM"/>
    <hasAnalysis rdf:resource="http://onto-finallife-uti.org/ontology#kdigo_CarlosM"/>
    <hasAnalysis rdf:resource="http://onto-finallife-uti.org/ontology#karnofsky_CarlosM"/>
    <hasAnalysis rdf:resource="http://onto-finallife-uti.org/ontology#creatinine_CarlosM"/>
    <hasAnalysis rdf:resource="http://onto-finallife-uti.org/ontology#bilirubin_CarlosM"/>
    <hasAnalysis rdf:resource="http://onto-finallife-uti.org/ontology#lactate_CarlosM"/>
    <hasAnalysis rdf:resource="http://onto-finallife-uti.org/ontology#fio2_CarlosM"/>
    <hasAnalysis rdf:resource="http://onto-finallife-uti.org/ontology#peep_CarlosM"/>
    <hasAnalysis rdf:resource="http://onto-finallife-uti.org/ontology#norepi_CarlosM"/>
    <hasAnalysis rdf:resource="http://onto-finallife-uti.org/ontology#neq_CarlosM"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#Agent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Agent</rdfs:label>
    <rdfs:comment xml:lang="en">Superclass of physicians, nurses, family members, and the ethics committee.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#MELDScore">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">MELD score (Model for End-Stage Liver Disease)</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#OrganSpecificStagingScale"/>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#HepaticFailure"/>
    <rdfs:comment xml:lang="en">Hepatic organ-failure staging score. MIMIC-IV derived table: mimiciv_derived.meld.</rdfs:comment>
    <mimic:meld>mimiciv_derived.meld</mimic:meld>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#WithdrawalOfLifeSustainingTreatmentDeath">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Death following withdrawal/withholding of life-sustaining treatment (LET)</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#CauseOfDeath"/>
    <rdfs:comment xml:lang="en">Death occurring after a therapeutic-futility determination led to a documented decision to withhold or withdraw life-sustaining treatment and to a Comfort-Measures-Only code status.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#APACHEIIScore">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">APACHE II score (Acute Physiology and Chronic Health Evaluation II)</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#SeverityScore"/>
    <rdfs:comment xml:lang="en">Classic ICU severity score (Knaus et al., 1985), not directly materialised in MIMIC-IV; its acute-physiology component is approximated in MIMIC-IV by the APS-III sub-score.</rdfs:comment>
  </rdf:Description>
