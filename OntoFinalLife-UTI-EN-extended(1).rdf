  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#MOFStageIII">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">MOF stage III (severe)</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#MOFSeverityStage"/>
    <rdfs:comment xml:lang="en">SOFA total score strictly greater than 9 and up to 12. Associated in-hospital mortality approximately 40-50%.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#Rule9_SWRL">
