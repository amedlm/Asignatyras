  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#Rule14_ReevaluationNeedDetection">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label xml:lang="en">Rule 14: Detection of re-evaluation needs</rdfs:label>
    <rdfs:comment>Patient_ICU(?p) ^ hasDecisionProcess(?p,?dp) ^ hasDecision(?dp,?d) ^ hasTemporalValidity(?d,?tv) ^ hasDecisionTime(?d,?dt) ^ hasReevaluationThreshold(?d,168) ^ [elapsed&gt;tv] -&gt; RequiresReevaluation(?d)</rdfs:comment>
  </rdf:Description>
