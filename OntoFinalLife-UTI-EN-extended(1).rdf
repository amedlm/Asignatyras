  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#RefractoryShockDeath">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Death due to refractory shock</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#CauseOfDeath"/>
    <rdfs:comment xml:lang="en">Death occurring as the consequence of circulatory failure unresponsive to maximal vasoactive/fluid support, evidenced by persistently elevated serum lactate and high norepinephrine-equivalent dose.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#Rule2_SWRL">
