    <rdfs:label xml:lang="en">Death due to cardiac arrest</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#CauseOfDeath"/>
    <rdfs:comment xml:lang="en">Death occurring as the consequence of an unresuscitated or unresuscitatable cardiac arrest, consistent with a Do-Not-Resuscitate (DNR) code status.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N7d74e058796b45869a232a0e243350ea">
