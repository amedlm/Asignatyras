  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#Rule20_MediationActivation">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label xml:lang="en">Rule 20: Activation of mediation</rdfs:label>
    <rdfs:comment>Patient_ICU(?p) ^ hasDisagreementWith(?a1,?a2) ^ hasSeverity(?disagreement,'moderate') ^ hasConsensusAttempts(?disagreement,?attempts) ^ swrlb:greaterThan(?attempts,2) -&gt; RequiresMediation(?disagreement)</rdfs:comment>
  </rdf:Description>
