    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
    <swrl:propertyPredicate rdf:resource="http://onto-finallife-uti.org/ontology#hasTreatmentOption"/>
    <swrl:argument1 rdf:resource="http://onto-finallife-uti.org/ontology#var_p"/>
    <swrl:argument2 rdf:resource="http://onto-finallife-uti.org/ontology#var_opt"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N0aed7a42c5ce40bca9692ca9904523f9">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
    <swrl:propertyPredicate rdf:resource="http://onto-finallife-uti.org/ontology#hasConsensus"/>
    <swrl:argument1 rdf:resource="http://onto-finallife-uti.org/ontology#var_dp"/>
    <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrl:argument2>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#ComfortMeasures">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Comfort measures</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#TreatmentOption"/>
    <rdfs:comment xml:lang="en">Concrete nursing and medical actions (analgesia, sedation, positioning, family presence) aimed purely at patient comfort once curative treatment has been limited.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N5a5ef351a313496aa2e3109fb20ec33a">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
    <swrl:classPredicate rdf:resource="http://onto-finallife-uti.org/ontology#Patient_ICU"/>
    <swrl:argument1 rdf:resource="http://onto-finallife-uti.org/ontology#var_p"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nc3b107e8940d4b76b49529f7a3a595bb">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
    <swrl:propertyPredicate rdf:resource="http://onto-finallife-uti.org/ontology#hasClinicalState"/>
    <swrl:argument1 rdf:resource="http://onto-finallife-uti.org/ontology#var_p"/>
    <swrl:argument2 rdf:resource="http://onto-finallife-uti.org/ontology#var_cs"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N485b0ff3f2b4427f9af3c685fe5e2069">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
    <swrl:propertyPredicate rdf:resource="http://onto-finallife-uti.org/ontology#hasAnalysis"/>
    <swrl:argument1 rdf:resource="http://onto-finallife-uti.org/ontology#var_p"/>
    <swrl:argument2 rdf:resource="http://onto-finallife-uti.org/ontology#var_f"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#Chaplain">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Chaplain / spiritual care provider</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#EthicsCommitteeMember"/>
    <rdfs:comment xml:lang="en">An ethics committee member who attends to the spiritual and religious dimension of end-of-life care.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Ndc3cc477276f45d6831f25bf305486b8">
    <rdf:first rdf:nodeID="Ncc4c712031d442f3a616cd86d757a89b"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#Rule29_CauseOfDeath_RefractoryRespiratory">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label xml:lang="en">Rule 29: Cause of death: refractory respiratory failure (FiO2 &gt;= 0.8 and PEEP &gt;= 10 cmH2O)</rdfs:label>
    <rdfs:comment>Patient_ICU(?p) ^ hasAnalysis(?p,?f) ^ FiO2(?f) ^ hasBiomarkerValue(?f,?fv) ^ swrlb:greaterThanOrEqual(?fv,0.8) ^ hasAnalysis(?p,?pe) ^ PEEP(?pe) ^ hasBiomarkerValue(?pe,?pv) ^ swrlb:greaterThanOrEqual(?pv,10.0) -&gt; hasCauseOfDeath(?p,CauseOfDeath_RefractoryRespFailure)</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#ICU_Team">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://onto-finallife-uti.org/ontology#HealthcareProfessional"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N01762bf7e6b146a69a457f7fabbc2108">
    <rdf:first rdf:nodeID="N8ab60d3533d44eada3212318941bdea1"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
