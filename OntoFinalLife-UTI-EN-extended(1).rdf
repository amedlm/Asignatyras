  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#ClinicalState">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Clinical state</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#ClinicalEntity"/>
    <rdfs:comment xml:lang="en">Represents the patient's current physiological/pathological condition as assessed by the ICU team, e.g. organ-failure status, reversibility, and symptom burden.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nc39513a46e684250a0e2438926b05594">
