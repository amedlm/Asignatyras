    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label xml:lang="en">Rule 18 (RDF/SWRL): Evidence-based recommendation</rdfs:label>
    <swrl:body rdf:nodeID="N6e18929a9d7c47c2b65a34db0ff929d2"/>
