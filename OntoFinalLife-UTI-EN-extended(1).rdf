  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#Rule23_MOFStageII_Calculation">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label xml:lang="en">Rule 23: Calculation of MOF stage II (SOFA 7-9)</rdfs:label>
    <rdfs:comment>Patient_ICU(?p) ^ hasAnalysis(?p,?s) ^ SOFAScore(?s) ^ hasSeverityScoreValue(?s,?v) ^ swrlb:greaterThan(?v,6.0) ^ swrlb:lessThanOrEqual(?v,9.0) -&gt; MOFStageII(?s)</rdfs:comment>
  </rdf:Description>
