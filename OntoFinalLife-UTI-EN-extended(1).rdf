    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
    <swrl:propertyPredicate rdf:resource="http://onto-finallife-uti.org/ontology#hasPrognosis"/>
    <swrl:argument1 rdf:resource="http://onto-finallife-uti.org/ontology#var_p"/>
    <swrl:argument2 rdf:resource="http://onto-finallife-uti.org/ontology#var_pr"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#Prognosis">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Prognosis</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#ClinicalEntity"/>
    <rdfs:comment xml:lang="en">Represents the projected clinical trajectory of a patient, notably the estimated probability of survival used by Rule 1 to detect futility.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#OrganFailure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Organ failure</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#ClinicalEntity"/>
    <rdfs:comment xml:lang="en">Loss of adequate function in a specific organ system; three or more concurrent instances trigger Rule 3 (multiple organ failure).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#hasClinicalAlignment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://onto-finallife-uti.org/ontology#DecisionProcess"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#hasOrganFailure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://onto-finallife-uti.org/ontology#ClinicalState"/>
    <rdfs:range rdf:resource="http://onto-finallife-uti.org/ontology#OrganFailure"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N196ca8b66c564356a3f7da03d7f5a8e9">
    <rdf:first rdf:nodeID="Nded8ea95d1f04c56b40b6c838b48dc88"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#HealthcareProfessional">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Healthcare professional</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#Agent"/>
    <rdfs:comment xml:lang="en">Any credentialed clinical staff member involved in the patient's care, including physicians, nurses, and allied health professionals.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N36aaeddaa22b457594acb35ceeceb54b">
    <rdf:first rdf:resource="http://onto-finallife-uti.org/ontology#var_prob"/>
