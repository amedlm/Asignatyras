  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#Situation_Futility">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Therapeutic futility situation</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#ClinicalState"/>
    <rdfs:comment xml:lang="en">Inferred by Rule 1 when the survival probability is below 0.01.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nbfb0dbd3d88d4425a9384467e29457b8">
    <rdf:first rdf:nodeID="Nda0ea0b6be3d45fb918d2539f82c602b"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#RefractoryRespiratoryFailureDeath">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Death due to refractory respiratory failure</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#CauseOfDeath"/>
    <rdfs:comment xml:lang="en">Death occurring as the consequence of hypoxemic respiratory failure unresponsive to maximal ventilatory support (high FiO2 and PEEP requirements, e.g. severe/refractory ARDS).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#ArtificialNutritionHydration">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Artificial nutrition and hydration (ANH)</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#TreatmentOption"/>
    <rdfs:comment xml:lang="en">Enteral or parenteral delivery of nutrients and fluids; frequently the subject of a specific limitation-of-treatment decision independent of other life support.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N60941819f2954cd484be83a8d8912090">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
    <swrl:classPredicate rdf:resource="http://onto-finallife-uti.org/ontology#Patient_ICU"/>
    <swrl:argument1 rdf:resource="http://onto-finallife-uti.org/ontology#var_p"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N015d26ec80a045888b5e4874ed8f4735">
    <rdf:first rdf:nodeID="N57d3ce9b020440c1a4bd43482c041366"/>
    <rdf:rest rdf:nodeID="Neb9b13422d994762b068589dfd01bfc3"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#PalliativeCare">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Palliative care</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#TreatmentOption"/>
    <rdfs:comment xml:lang="en">Care focused on relieving suffering and improving quality of life rather than curing the underlying disease.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N093a118c704f4223a1152b85004616fb">
