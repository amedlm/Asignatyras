    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N7d77fb3776254b888dd32980b6dbd123">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
    <swrl:propertyPredicate rdf:resource="http://onto-finallife-uti.org/ontology#hasTimeWindow"/>
    <swrl:argument1 rdf:resource="http://onto-finallife-uti.org/ontology#var_cs"/>
    <swrl:argument2 rdf:resource="http://onto-finallife-uti.org/ontology#var_tw"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#Rule24_MOFStageIII_Calculation">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label xml:lang="en">Rule 24: Calculation of MOF stage III (SOFA 10-12)</rdfs:label>
    <rdfs:comment>Patient_ICU(?p) ^ hasAnalysis(?p,?s) ^ SOFAScore(?s) ^ hasSeverityScoreValue(?s,?v) ^ swrlb:greaterThan(?v,9.0) ^ swrlb:lessThanOrEqual(?v,12.0) -&gt; MOFStageIII(?s)</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N738f88528f5a40e38e75bc29d6631509">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
    <swrl:classPredicate rdf:resource="http://onto-finallife-uti.org/ontology#CompleteDocumentation"/>
    <swrl:argument1 rdf:resource="http://onto-finallife-uti.org/ontology#var_dp"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#DecisionProcess1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://onto-finallife-uti.org/ontology#DecisionProcess"/>
    <hasAgent rdf:resource="http://onto-finallife-uti.org/ontology#Maria"/>
    <hasAgent rdf:resource="http://onto-finallife-uti.org/ontology#ICU_Team"/>
    <produces rdf:resource="http://onto-finallife-uti.org/ontology#Decision_Withdrawal_CarlosM"/>
    <requiresConsultation rdf:resource="http://onto-finallife-uti.org/ontology#ClinicalEthicsCommittee"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#QualityDecision">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Quality decision</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#Decision"/>
    <rdfs:comment xml:lang="en">A decision that meets the ontology's quality bar: reached by consensus, ethically consistent, and clinically aligned (output of Rule 13).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#GlasgowComaScaleScore">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Glasgow Coma Scale (GCS)</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#SeverityScore"/>
    <rdfs:comment xml:lang="en">Eye/verbal/motor consciousness score, also used as a SOFA/APACHE/LODS sub-component. MIMIC-IV derived tables: mimiciv_derived.gcs, mimiciv_derived.first_day_gcs.</rdfs:comment>
    <skos:exactMatch rdf:resource="http://loinc.org/9269-2"/>
    <mimic:gcs>mimiciv_derived.gcs; mimiciv_derived.first_day_gcs</mimic:gcs>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#Non_Suffering">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://onto-finallife-uti.org/ontology#PatientValue"/>
    <rdfs:label xml:lang="en">Freedom from suffering</rdfs:label>
  </rdf:Description>
