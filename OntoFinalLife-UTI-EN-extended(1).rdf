  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#Rule27_CauseOfDeath_MOF">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label xml:lang="en">Rule 27: Cause of death: irreversible multiple organ failure with withdrawal decision</rdfs:label>
    <rdfs:comment>Patient_ICU(?p) ^ hasClinicalState(?p,?cs) ^ MultipleOrganFailureSituation(?cs) ^ hasReversalPotential(?cs,false) ^ hasDecisionProcess(?p,?dp) ^ hasDecision(?dp,?d) ^ Decision_Withdrawal(?d) -&gt; hasCauseOfDeath(?p,CauseOfDeath_MOF)</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#ReevaluationPeriod">
