    <swrl:arguments rdf:nodeID="N135818eacd11441993f54e9f1d0269eb"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#hasTimeWindow">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:comment xml:lang="en">Time window in hours.</rdfs:comment>
  </rdf:Description>
