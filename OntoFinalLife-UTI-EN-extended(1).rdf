    <swrl:argument2 rdf:resource="http://onto-finallife-uti.org/ontology#var_dp"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#LODSScore">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">LODS score (Logistic Organ Dysfunction System)</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#SeverityScore"/>
    <rdfs:comment xml:lang="en">MIMIC-IV derived table: mimiciv_derived.lods.</rdfs:comment>
    <mimic:lods>mimiciv_derived.lods</mimic:lods>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N0c4ea92970cf4a17bbe20af6344153e8">
    <rdf:first rdf:nodeID="N4e50ed22c2c94783ab4da9057b78ef99"/>
