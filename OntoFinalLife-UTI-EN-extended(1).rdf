    <rdfs:comment xml:lang="en">Inadequate kidney function, commonly staged in this ontology via the KDIGO scale.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#Rule3_MultipleOrganFailure">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label xml:lang="en">Rule 3: Identification of multiple organ failure</rdfs:label>
    <rdfs:comment>Patient_ICU(?p) ^ hasClinicalState(?p,?cs) ^ hasOrganFailure(?cs,?of1) ^ hasOrganFailure(?cs,?of2) ^ hasOrganFailure(?cs,?of3) ^ [?of1&lt;&gt;?of2&lt;&gt;?of3] -&gt; MultipleOrganFailureSituation(?cs)</rdfs:comment>
  </rdf:Description>
