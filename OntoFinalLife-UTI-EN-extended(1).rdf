    <swrl:argument2 rdf:resource="http://onto-finallife-uti.org/ontology#var_of1"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#DNI">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Do Not Intubate (DNI)</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#CodeStatus"/>
    <rdfs:comment xml:lang="en">A code status instructing that endotracheal intubation should not be performed.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#expressesValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://onto-finallife-uti.org/ontology#Agent"/>
    <rdfs:range rdf:resource="http://onto-finallife-uti.org/ontology#PatientValue"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#Beneficence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://onto-finallife-uti.org/ontology#EthicalPrinciple"/>
    <rdfs:label xml:lang="en">Beneficence</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N5e597213fb5443369d271fb3b036febf">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
    <swrl:propertyPredicate rdf:resource="http://onto-finallife-uti.org/ontology#hasPriority"/>
    <swrl:argument1 rdf:resource="http://onto-finallife-uti.org/ontology#var_v1"/>
    <swrl:argument2>high</swrl:argument2>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N1817629426b6498ca3c429d2b6a285d0">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
