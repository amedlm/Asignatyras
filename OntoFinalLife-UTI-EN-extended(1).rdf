  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#Rule28_CauseOfDeath_RefractoryShock">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label xml:lang="en">Rule 28: Cause of death: refractory shock (lactate &gt; 4.0 mmol/L and NEE &gt;= 1.0 mcg/kg/min)</rdfs:label>
    <rdfs:comment>Patient_ICU(?p) ^ hasAnalysis(?p,?lac) ^ SerumLactate(?lac) ^ hasBiomarkerValue(?lac,?lv) ^ swrlb:greaterThan(?lv,4.0) ^ hasAnalysis(?p,?neq) ^ NorepinephrineEquivalentDose(?neq) ^ hasBiomarkerValue(?neq,?nv) ^ swrlb:greaterThanOrEqual(?nv,1.0) -&gt; hasCauseOfDeath(?p,CauseOfDeath_RefractoryShock)</rdfs:comment>
  </rdf:Description>
