    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Death due to multiple organ failure (MOF)</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#CauseOfDeath"/>
    <rdfs:comment xml:lang="en">Death occurring as the terminal consequence of an irreversible multiple organ failure syndrome (&gt;=3 concurrent organ failures with no reversal potential).</rdfs:comment>
  </rdf:Description>
