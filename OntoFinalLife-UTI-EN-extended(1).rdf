  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#ExtracorporealMembraneOxygenation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Extracorporeal membrane oxygenation (ECMO)</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#TreatmentOption"/>
    <rdfs:comment xml:lang="en">Extracorporeal circulatory/respiratory life support used when conventional mechanical ventilation and/or vasoactive support fail to sustain gas exchange or perfusion.</rdfs:comment>
    <skos:exactMatch rdf:resource="http://snomed.info/id/233573008"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#HepaticFailure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Hepatic failure</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#OrganFailure"/>
    <rdfs:comment xml:lang="en">Inadequate liver function, commonly staged in this ontology via the MELD score.</rdfs:comment>
  </rdf:Description>
