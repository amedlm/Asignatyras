  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#CharlsonComorbidityIndex">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Charlson Comorbidity Index (CCI)</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#ComorbidityIndex"/>
    <rdfs:comment xml:lang="en">Weighted comorbidity burden index derived from ICD-9/ICD-10 diagnosis codes. MIMIC-IV derived table: mimiciv_derived.charlson. Reference: Charlson et al., 1987.</rdfs:comment>
    <mimic:charlson>mimiciv_derived.charlson</mimic:charlson>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#PatientAdvocate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Patient advocate</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#EthicsCommitteeMember"/>
    <rdfs:comment xml:lang="en">An ethics committee member whose role is to represent the patient's interests and perspective in deliberation.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#hasReevaluationThreshold">
