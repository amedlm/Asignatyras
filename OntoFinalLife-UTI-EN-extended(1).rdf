    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#TreatmentOption"/>
    <rdfs:comment xml:lang="en">Dialysis or continuous renal replacement therapy used to substitute for lost kidney function.</rdfs:comment>
  </rdf:Description>
