  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#KarnofskyPerformanceStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Karnofsky Performance Status (KPS)</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#FunctionalStatusScale"/>
    <rdfs:comment xml:lang="en">0-100 scale of a patient's baseline functional independence, widely used in oncology and palliative care to inform goals-of-care discussions. Not part of the standard MIMIC-IV derived-concepts schema (MIMIC captures acute ICU physiology rather than baseline performance status); included here because it directly feeds the evaluative (quality-of-life) dimension of end-of-life deliberation. LOINC: 89129-6.</rdfs:comment>
    <skos:exactMatch rdf:resource="http://loinc.org/89129-6"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N16012500d21e42f7bf675a3f2f0f88f8">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
