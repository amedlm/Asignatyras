  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#Rule11_SpecificTreatmentLimitation">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label xml:lang="en">Rule 11: Specific treatment limitation</rdfs:label>
    <rdfs:comment>Patient_ICU(?p) ^ Situation_Futility(?cs) ^ hasTreatmentOption(?p,?opt) ^ hasProbabilitySurvival(?opt,?prob) ^ swrlb:lessThan(?prob,0.01) -&gt; LimitTreatment(?opt)</rdfs:comment>
  </rdf:Description>
