    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#PatientValue"/>
    <rdfs:comment xml:lang="en">A patient value concerned with the perceived quality, rather than mere duration, of remaining life.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#Rule7_EthicsCommitteeActivation">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label xml:lang="en">Rule 7: Activation of ethics committee consultation</rdfs:label>
    <rdfs:comment>Patient_ICU(?p) ^ hasDecisionProcess(?p,?dp) ^ hasDisagreementWith(?dp,?agent) ^ hasSeverity(?dp,'high') -&gt; requiresConsultation(?dp, EthicsCommittee)</rdfs:comment>
  </rdf:Description>
