    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
    <swrl:propertyPredicate rdf:resource="http://onto-finallife-uti.org/ontology#hasBiomarkerValue"/>
    <swrl:argument1 rdf:resource="http://onto-finallife-uti.org/ontology#var_pe"/>
