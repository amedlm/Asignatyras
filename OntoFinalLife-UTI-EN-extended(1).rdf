  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#ComfortMeasuresOnly">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Comfort Measures Only (CMO)</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#CodeStatus"/>
    <rdfs:comment xml:lang="en">Terminal code status indicating exclusive focus on comfort; closely aligned with the ontology's ComfortMeasures and IndicatedPalliativeCare classes.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Ne65b6bd0ed1e4c02819d2dc6681c304a">
