  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#Rule16_AuditTrailGeneration">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label xml:lang="en">Rule 16: Audit trail generation</rdfs:label>
    <rdfs:comment>Patient_ICU(?p) ^ hasDecisionProcess(?p,?dp) ^ hasAgent(?dp,?a) ^ hasTimestamp(?dp,?t) ^ hasDecision(?dp,?d) -&gt; generatesAuditTrail(?dp,?trail)</rdfs:comment>
  </rdf:Description>
