  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#Rule5_NonMaleficenceViolation">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label xml:lang="en">Rule 5: Detection of non-maleficence violation</rdfs:label>
    <rdfs:comment>Patient_ICU(?p) ^ hasTreatmentOption(?p,?opt) ^ hasRiskOfHarm(?opt,?harm) ^ hasSeverity(?harm,'high') ^ hasBenefit(?opt,?ben) ^ swrlb:lessThan(?ben,?harm) -&gt; PrincipleViolation(?conflict)</rdfs:comment>
  </rdf:Description>
