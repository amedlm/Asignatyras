  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#Rule18_EvidenceBasedRecommendation">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label xml:lang="en">Rule 18: Evidence-based recommendation</rdfs:label>
    <rdfs:comment>Patient_ICU(?p) ^ hasClinicalState(?p,?cs) ^ Situation_Futility(?cs) ^ hasGuidelineRecommendation(?cs,?rec) ^ hasStrengthOfRecommendation(?rec,'strong') -&gt; EvidenceBasedRecommendation(?rec)</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#var_d">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/>
  </rdf:Description>
