  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#Rule1_TherapeuticFutility">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label xml:lang="en">Rule 1: Identification of therapeutic futility</rdfs:label>
    <rdfs:comment>Patient_ICU(?p) ^ hasClinicalState(?p,?cs) ^ hasReversalPotential(?cs,false) ^ hasPrognosis(?p,?pr) ^ hasSurvivalProbability(?pr,?prob) ^ swrlb:lessThan(?prob,0.01) -&gt; Situation_Futility(?cs)</rdfs:comment>
  </rdf:Description>
