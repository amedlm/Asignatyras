    <rdfs:label xml:lang="en">Neurological (CNS) failure</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#OrganFailure"/>
    <rdfs:comment xml:lang="en">Impaired central nervous system function, typically assessed via the Glasgow Coma Scale.</rdfs:comment>
  </rdf:Description>
