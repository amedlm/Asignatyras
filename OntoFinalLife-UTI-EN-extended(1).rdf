  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#Biomarker">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Biomarker</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#ClinicalAnalysis"/>
    <rdfs:comment xml:lang="en">A measurable biological indicator (laboratory value or clinical measurement) used to assess organ function or physiological status.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N368a5b1c199243aea1af9214d744fe6c">
