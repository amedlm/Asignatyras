  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#Rule22_MOFStageI_Calculation">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
    <rdfs:label xml:lang="en">Rule 22: Calculation of MOF stage I (SOFA 0-6)</rdfs:label>
    <rdfs:comment>Patient_ICU(?p) ^ hasAnalysis(?p,?s) ^ SOFAScore(?s) ^ hasSeverityScoreValue(?s,?v) ^ swrlb:greaterThanOrEqual(?v,0.0) ^ swrlb:lessThanOrEqual(?v,6.0) -&gt; MOFStageI(?s)</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#ValuesAlignedOption">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Values-aligned treatment option</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#TreatmentOption"/>
    <rdfs:comment xml:lang="en">A treatment option confirmed compatible with the patient's expressed values (output of Rule 6).</rdfs:comment>
  </rdf:Description>
