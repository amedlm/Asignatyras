  <rdf:Description rdf:about="http://onto-finallife-uti.org/ontology#Option_Against_Values">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Treatment option contrary to patient values</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://onto-finallife-uti.org/ontology#EthicalEntity"/>
    <rdfs:comment xml:lang="en">A treatment option that has been found incompatible with a patient's expressed values or advance directive.</rdfs:comment>
  </rdf:Description>
